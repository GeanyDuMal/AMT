{% extends 'base.html.twig' %}
{% block title %}
    Statistiques
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/statistiques/statistique.css') }}">
{% endblock %}

{% block body %}
    <div class="main-block flex-vertical flex-centered">
        <div>
            <h1 class="title">
                Statistiques
            </h1>
        </div>
        <div class="list-card flex-horizontal flex-centered flex-overflow">
            <div class="card flex-vertical flex-centered card-color-1">
                <div class="card-title">
                    Chiffre d'affaire (Semaine)
                </div>
                <div class="card-text">
                    {% if salesRevenueThisWeek is not null  %}
                        {{ salesRevenueThisWeek }}
                    {% else %}
                        0
                    {% endif %} €
                </div>
            </div>

            <div class="card flex-vertical flex-centered card-color-1">
                <div class="card-title">
                    Dépense moyenne par Client (Semaine)
                </div>
                <div class="card-text">
                    {% if averagePerStudent is null %}
                        0
                    {% else %}
                        {{ averagePerStudent }}
                    {% endif %} €
                </div>
            </div>

            <div class="card flex-vertical flex-centered card-color-1">
                <div class="card-title">
                    Chiffre d'affaire (Mois)
                </div>
                <div class="card-text">
                    {% if salesRevenueThisMonth is not null  %}
                        {{ salesRevenueThisMonth }}
                    {% else %}
                        0
                    {% endif %} €
                </div>
            </div>

            <div class="card flex-vertical flex-centered card-color-2">
                <div class="card-title">
                    Nombre de Post
                </div>
                <div class="card-text">
                    {{ postsNumber }}
                </div>
            </div>

            <div class="card flex-vertical flex-centered card-color-2">
                <div class="card-title">
                    Nombre de Client
                </div>
                <div class="card-text">
                    {{ countClients }}
                </div>
            </div>

            <div class="card flex-vertical flex-centered card-color-2">
                <div class="card-title">
                    Nombre de Cotisant
                </div>
                <div class="card-text">
                    {{ countCotisant }}
                </div>
            </div>

            {% if productsWarningStock %}
                <div class="card flex-vertical flex-centered card-color-3">
                    <div class="card-title">
                        Produit en seuil d'alerte
                    </div>
                    <div class="card-text flex-vertical flex-align-left">
                        {% for product in productsWarningStock %}
                            <div>
                                {{ product.name }}, {{ product.quantityStock }} restant(s)
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if productsEmptyStock %}
                <div class="card flex-vertical flex-centered card-color-3">
                    <div class="card-title">
                        Produit en rupture de stock
                    </div>
                    <div class="card-text flex-vertical flex-align-left">
                        {% for product in productsEmptyStock %}
                            <div>
                                {{ product.name }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <div class="card flex-vertical flex-centered card-color-3">
                <div class="card-title">
                    Top ventes du mois
                </div>
                <div class="card-text flex-vertical flex-align-left">
                    {% for productAndQuantity in topSoldProduct %}
                        <div>
                            {{ productAndQuantity.product.name }}, {{ productAndQuantity.quantitySold }} vendu(s)
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

{% endblock %}
{% block javascripts %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js" integrity="sha512-TW5s0IT/IppJtu76UbysrBH9Hy/5X41OTAbQuffZFU6lQ1rdcLHzpU5BzVvr/YFykoiMYZVWlr/PX1mDcfM9Qg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="{{ asset('script/statistiques/statistiques.js') }}"></script>
    <script>
        initChart({{ thisWeek | raw }}, {{ orderCount | raw }})
    </script>
{% endblock %}