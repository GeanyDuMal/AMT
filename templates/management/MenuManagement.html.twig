{% extends 'base.html.twig' %}

{% block title %}
    Interface de Gestion
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/management/management.css') }}">
{% endblock %}

{% block javascripts %}
{% endblock %}

{% block body %}
    <div class="flex-vertical flex-centered main-block">
        {% if message != "" %}
            <div class="flex-horizontal flex-centered">
                <div class="message message-information">
                    {{ message }}
                </div>
            </div>
        {% endif %}
        <h1 class="title-block">
            Interface de Gestion
        </h1>
        <form action="" class="flex-vertical flex-centered" method="post" id="form-management" onsubmit="disableButton()">
            <div class="flex-vertical flex-centered">
                <h2>
                    Purge
                </h2>
                <div class="flex-horizontal flex-centered block-control">
                    <button type="submit" name="clearCotisant" value="true" class="btn btn-primary disableable">
                        Purger les cotisants
                    </button>
                    <div>
                        Définir tout les cotisants comme étudiant.
                    </div>
                </div>
                <div class="flex-horizontal flex-centered block-control">
                    <button type="submit" name="clearMembers" value="true" class="btn btn-primary disableable">
                        Purger l'association
                    </button>
                    <div>
                        Définir tout les membres de l'association comme étudiant (sauf le président).
                    </div>
                </div>
                <div class="flex-horizontal flex-centered block-control">
                    <button type="submit" name="clearOldClient" value="true" class="btn btn-primary disableable">
                        Purger les clients
                    </button>
                    <div>
                        Supprimer les clients n'ayant effectué aucune action depuis 2 ans.
                    </div>
                </div>
                <div class="flex-horizontal flex-centered block-control">
                    <button type="submit" name="clearProduct" value="true" class="btn btn-primary disableable">
                        Purger les produits
                    </button>
                    <div>
                        Supprimer les produits n'ayant plus été commandé depuis 1 an et dont le stock est vide.
                    </div>
                </div>
                <div class="flex-horizontal flex-centered block-control">
                    <button type="submit" name="clearOrder" value="true" class="btn btn-primary disableable">
                        Purger les commandes
                    </button>
                    <div>
                        Supprimer les commandes datant d'au moins 1 an sans client.
                    </div>
                </div>
                <div class="flex-horizontal flex-centered block-control">
                    <button type="submit" name="clearPost" value="true" class="btn btn-primary disableable">
                        Purger les posts
                    </button>
                    <div>
                        Supprimer les 3 posts les plus anciens.
                    </div>
                </div>
                <h2>
                    Reinitialisation de mot de passe
                </h2>
                <div class="flex-horizontal flex-centered flex-overflow block-control block-password">
                    {% if requestList|length > 0 %}
                        <div class="flex-vertical sub-block">
                            <button type="submit" name="suppressPasswordRequest" value="true" class="btn btn-secondary disableable">
                                Supprimer la demande
                            </button>
                            <button type="submit" name="resetPassword" value="true" class="btn btn-primary disableable">
                                Reinitialiser
                            </button>
                        </div>
                        <div class="flex-horizontal flex-overflow sub-block">
                            <select name="passwordRequest" id="" class="form-input form-select">
                                {% for request in requestList %}
                                    <option value="{{ request.client.id }}">{{ request.client.name }} {{ request.client.firstName }}</option>
                                {% endfor %}
                            </select>
                            <input type="text" name="confirmationCode" placeholder="Code de confirmation" class="form-input">
                        </div>
                    {% else %}
                        <p class="text-block">
                             Pas de requête de reinitialisation actuellement
                        </p>
                    {% endif %}
                </div>
            </div>
        </form>
    </div>
{% endblock %}
