{% extends 'base.html.twig' %}

{% block title %}
    Modification Client
{% endblock %}

{%  block javascripts %}
    <script type="text/javascript" src="{{ asset('script/client/addEditScripts.js') }}"></script>
    <script type="text/javascript" src="{{ asset('script/generic/formGenericFunction.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/bootstrap.css') }}">
    <link rel='stylesheet' href="{{ asset('style/client/index.css') }}">
{% endblock %}

{% block body %}
    {% if message %}
        <div class="alert alert-dismissible alert-info fade show">
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            <strong>{{ message }}</strong>
        </div>
    {% endif %}

    <div class="container mt-5">
        <form action="" method="post" class="row g-3" id='form_Client' onsubmit="disableButton()">
            <h1>Modification</h1>
            <div class="form-floating col-md-6">
                <input type="text" name="name"  class="form-control" id="floatingInput" placeholder="Nom" value={% if client %}{{ client.name}} {% endif  %}>
                <label for="floatingInput">Nom</label>
            </div>
            <div class="form-floating col-md-6">
                <input type="text" name="firstName"  class="form-control" id="floatingInput" placeholder="Prénom" value={% if client %}{{ client.firstName}} {% endif  %}>
                <label for="floatingInput">Prénom</label>
            </div>
            <br>
            <div class="form-floating mb-3">
                <input type="text" name="login" class="form-control" id="floatingInput" name="login" placeholder="Login" disabled value={% if client %}{{ client.login}} {% endif  %}>
                <label for="floatingInput">Login</label>
            </div>
            <br>

            <div class="form-group col-md-6">
                <label>Solde</label>
                <div class="input-group mb-3">
                    <span class="input-group-text">€</span>
                    <input type="text" name="balance" class="form-control" aria-label="Amount (to the nearest euro)" value={% if client %}{{ client.balance}} {% else %}0{% endif  %}>
                </div>
            </div>
            <div class="form-group col-md-6">
                <label>Point Fidélité</label>
                <div class="input-group mb-3">
                    <input type="text" name="fidelityPoint" class="form-control" value={% if client %}{{ client.fidelityPoint}} {% else %}0{% endif  %}>
                </div>
            </div>

            <div class="form-group col-md-12">
                <label>Type</label>
                <select class="form-select" name="clientType" id="clientType" data-target="assosRoles"
                        data-source="path">
                    {% if client %}
                        {% for clientType in clientTypes %}
                            <option {% if clientType == client.clientType %} selected {% endif %}>
                                {{ clientType }}
                            </option>
                        {% endfor %}
                    {% endif %}
                </select>
            </div>
            <div class="form-group col-md-12" id="roles">
                <label>Role</label>
                <select name="assosRoles" id="assosRoles" class="form-control linked-select"  id="clientType">
                    {% set memberRoleName = null %}
                    {% if member %}
                        {% set memberRoleName = member.role %}
                    {% endif %}

                    {% for assosRole in assosRoles %}
                        <option {% if assosRole == memberRoleName %} selected {% endif %} >
                            {{assosRole}}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <br>
            <button type="submit" class="btn btn-primary disableable" onclick="return verifyEdit()" style="margin-bottom: 25px;">
                Enregistrer
            </button>
        </form>
    </div>
{% endblock %}
