{% extends 'base.html.twig' %}

{% block title %}
    Modification Client
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('script/client/addEditScripts.js') }}"></script>
    <script type="text/javascript" src="{{ asset('script/generic/formGenericFunction.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/client/client.css') }}">
{% endblock %}

{% block body %}
    <div class="flex-vertical flex-centered main-block">
        <h2 class="title">
            Modification d'un Client
        </h2>
        <div>
            {% if message != "" %}
                <div class="form-group flex-horizontal flex-centered">
                    <div class="message message-incorrect">
                        {{ message }}
                    </div>
                </div>
            {% endif %}
        </div>
        <form action="" method="post" class="flex-vertical flex-centered" id="form-client" onsubmit="disableButton()">
            <div class="flex-horizontal block-form-group">
                <div class="form-group">
                    <label for="name" class="input-label">Nom</label>
                    <input type="text" name="name" class="form-input" value="{% if client %}{{ client.name }}{% endif %}">
                </div>
                <div class="form-group">
                    <label for="firstName" class="input-label">Prénom</label>
                    <input type="text" name="firstName" class="form-input"
                           value="{% if client %}{{ client.firstName }}{% endif %}">
                </div>
            </div>
            <div class="form-group">
                <label for="login" class="input-label">Login</label>
                <input type="text" name="login" class="form-input" disabled value="{% if client %}{{ client.login }}{% endif %}">
                {% if not client %}
                    <ul class="list-ul">
                        <li>Au moins 5 caractères</li>
                    </ul>
                {% endif %}
            </div>
            <div class="form-group">
                <p>
                    Compte créé le {{ client.creationDate | date('d/m/Y') }}
                </p>
            </div>
            <div class="flex-horizontal block-form-group">
                <div class="form-group">
                    <label class="input-label">Type</label>
                    <select class="form-input" name="clientType" id="clientType">
                        {% for clientType in clientTypes %}
                            <option {% if clientType == client.clientType %} selected {% endif %}>
                                {{ clientType }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group" id="roles">
                    <label class="input-label">Role</label>
                    <select name="assosRoles" id="assosRoles" class="form-input">
                        {% set memberRoleName = null %}
                        {% if member %}
                            {% set memberRoleName = member.role %}
                        {% endif %}

                        {% for assosRole in assosRoles %}
                            <option {% if client and assosRole == memberRoleName %} selected {% endif %} >
                                {{ assosRole }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="flex-horizontal block-form-group">
                <div class="form-group">
                    <label class="input-label">Solde (en €)</label>
                    <input type="text" name="balance" class="form-input" value="{% if client %}{{ client.balance }}{% else %}0{% endif %}">
                </div>
                <div class="form-group">
                    <label class="input-label">Point de Fidélité</label>
                    <input type="text" name="fidelityPoint" class="form-input" value={% if client %}{{ client.fidelityPoint }}{% else %}0{% endif %}>
                </div>
            </div>
            <button type="submit" class="btn btn-primary disableable" onclick="return verifyEdit()">
                Modifier
            </button>
        </form>
        {# End Form #}
        <a href="{{ path("menuClient") }}">
            <img src="{{ asset('img/icons/back.png') }}" class="back-arrow-pages">
        </a>
    </div>
{% endblock %}
