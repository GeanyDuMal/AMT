{% extends 'base.html.twig' %}

{% block title %}
	Liste clients
{% endblock %}

{% block stylesheets %}

	{# CSS pour les tableaux  #}
	<link rel='stylesheet' href="https://cdn.datatables.net/1.11.3/css/jquery.dataTables.min.css">
	<link rel='stylesheet' href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.dataTables.min.css">
	<link rel='stylesheet' href="{{ asset('style/base/table.css') }}">

	<link rel='stylesheet' href="{{ asset('style/client/client.css') }}">
{% endblock %}

{% block javascripts %}
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
	<script type="text/javascript" src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>

	<script type="text/javascript" src="{{ asset('script/client/ajaxMenuClient.js') }}"></script>
{% endblock %}

{% block body %}
	<div class="main-block flex-vertical flex-centered">
		<h2 class="title-1">
			Liste des clients
		</h2>
		<div>
			{% if message != "" %}
				<div class="flex-horizontal flex-centered">
					<div class="message message-information">
						{{ message }}
					</div>
				</div>
			{% endif %}
		</div>
		<div class="flex-align-self-left">
			<a href="{{ path('createClient') }}">
				<button class="btn btn-primary">
					Ajouter
				</button>
			</a>
		</div>
		<br>
		{% if clients|length > 0 %}
		<table id="client-table" class="table">
			<thead>
			<tr>
				<th>Nom</th>
				<th>Prénom</th>
				<th class="hide-phone">Type du client</th>
				{% if is_granted('ROLE_SECRETAIRE') %}
					<th>Modifier</th>
				{% endif %}
				<th>Détails</th>
			</tr>
			</thead>
			<tbody>
			{% for client in clients %}
				{% if app.user.login!=client.login %}
				<tr id="data">
					<td>{{ client.name }}</td>
					<td>{{ client.firstname }}</td>
					<td class="hide-phone">{{ client.clientType.value }}</td>
					{% if is_granted('ROLE_SECRETAIRE') %}
						<td>
							<a href="{{ path('editClient',{id: client.id}) }}">
								<button class="btn btn-secondary">
									Modifier
								</button>
							</a>
						</td>
					{% endif %}
					<td>
						<a href="{{ path('showClient',{id: client.id}) }}">
							<button class="btn btn-primary">
								Voir plus
							</button>
						</a>
					</td>
				</tr>
				{% endif %}
			{% endfor %}
			</tbody>
		</table>
		{% else %}
			<div class="flex-horizontal flex-centered">
				<div class="message message-incorrect">
					Il n'y a pas encore de client.
				</div>
			</div>
		{% endif %}
	</div>
{% endblock %}
