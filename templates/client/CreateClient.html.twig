{% extends 'base.html.twig' %}

{% block title %}
    Nouveau Client
{% endblock %}

{%  block javascripts %}
    <script type="text/javascript" src="{{  asset('script/generic/formGenericFunction.js') }}"></script>
    <script type="text/javascript" src="{{  asset('script/client/addEditScripts.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/client/client.css') }}">
{% endblock %}

{% block body %}
    <div class="flex-vertical flex-centered main-block">
        <h2 class="title">
            Création d'un Client
        </h2>
        <div>
            {% if message != "" %}
                <div class="form-group flex-horizontal flex-centered">
                    <div class="message message-incorrect">
                        {{ message }}
                    </div>
                </div>
            {% endif %}
        </div>
        <form action="" method="post" class="flex-vertical flex-centered" id="form-client" onsubmit="disableButton()">
            <div class="flex-horizontal block-form-group">
                <div class="form-group">
                    <label for="name" class="input-label">Nom</label>
                    <input type="text" name="name" class="form-input" value="">
                </div>
                <div class="form-group">
                    <label for="firstName" class="input-label">Prénom</label>
                    <input type="text" name="firstName" class="form-input" value="">
                </div>
            </div>
            <div class="form-group">
                <label for="login" class="input-label">Login</label>
                <input type="text" name="login" class="form-input" value="">
                <ul class="list-ul">
                    <li>Au moins 5 caractères</li>
                </ul>
            </div>
            <div class="flex-horizontal block-form-group">
                <div class="form-group">
                    <label for="password" class="input-label">Mot De Passe</label>
                    <input type="password" name="password" class="form-input">
                    <ul class="list-ul">
                        <li>Au moins 5 caractères</li>
                        <li>Au moins 1 caractère spécial</li>
                    </ul>
                </div>
                <div class="form-group">
                    <label for="confirmPassword" class="input-label">Confirmation</label>
                    <input type="password" name="confirmPassword" class="form-input">
                </div>
            </div>
            <div class="flex-horizontal block-form-group">
                <div class="form-group">
                    <label class="input-label">Type</label>
                    <select class="form-input" name="clientType" id="clientType">
                        {% for clientType in clientTypes %}
                            <option>
                                {{ clientType }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group" id="roles">
                    <label class="input-label">Role</label>
                    <select name="assosRoles" id="assosRoles" class="form-input">
                        {% for assosRole in assosRoles %}
                            <option>
                                {{ assosRole }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="flex-horizontal block-form-group">
                <div class="form-group">
                    <label class="input-label">Solde (en €)</label>
                    <input value="0" type="text" name="balance" class="form-input">
                </div>
                <div class="form-group"></div>
            </div>
            <button type="submit" class="btn btn-primary disableable" onclick="return verifyAdd()">
                Créer
            </button>
        </form>
        {# End Form #}
        <a href="{{ path("menuClient") }}">
            <img src="{{ asset('img/icons/back.png') }}" class="back-arrow-pages">
        </a>
    </div>
{% endblock %}
