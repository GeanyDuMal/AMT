{% extends 'base.html.twig' %}

{% block title %}
    Affichage Produit
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/product/product.css') }}">
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('script/product/showProduct.js') }}"></script>
{% endblock %}

{% block body %}
    <div class="flex-vertical flex-centered main-block">
        <h2 class="title">
            {{ product.name }}
        </h2>
        <div class="show-container flex-vertical flex-centered">
            <div class="show-block">
                <img class="show-image" src="{{ product.imageLink }}">
            </div>
            <div class="show-block flex-horizontal">
                <div class="show-sub-block">
                    <label class="input-label">Quantité en stock</label>
                    <p>
                        {{ product.quantityStock }}
                    </p>
                </div>
                <div class="show-sub-block">
                    <label class="input-label">Type de produit</label>
                    <p>
                        {{ product.productType }}
                    </p>
                </div>
            </div>
            <p class="show-block-title flex-align-self-left">
                Tarification
            </p>
            <div class="show-block flex-horizontal">
                {% for price in product.prices %}
                    <div class="show-sub-block">
                        <label class="input-label">Prix {{ price.clientType }}</label>
                        <p>
                            {{ (price.price)|number_format(2,'.') }}€
                        </p>
                    </div>
                {% endfor %}
            </div>
        </div>
        <div class="flex-horizontal flex-centered">
            <a href="{{ path('editProduct',{id: product.id}) }}">
                <button class="btn btn-primary">
                    Modifier
                </button>
            </a>
            <a href="{{ path("menuProduct") }}">
                <img src="{{ asset('img/icons/back.png') }}" class="back-arrow-pages">
            </a>
            <a href="{{ path('deleteProduct', {'id': product.id }) }}" onclick="return confirmDelete()">
                <button class="btn btn-secondary">
                    Supprimer
                </button>
            </a>
        </div>
    </div>
{% endblock %}