{% extends 'base.html.twig' %}

{% block title %}
    Modifier un produit
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/bootstrap.css') }}">
    <link rel='stylesheet' href="{{ asset('style/client/index.css') }}">
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('script/product/addEditVerifications.js') }}"></script>
    <script type="text/javascript" src="{{ asset('script/generic/formGenericFunction.js') }}"></script>
{% endblock %}

{% block body %}
    <div>
        {% if message != "" %}
            <div class="alert alert-dismissible alert-info fade show">
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <strong>{{ message }}</strong>
            </div>
        {% endif %}
    </div>
    <div class="container mt-5 ">
        <form id="product_form" action="" class="row g-2" method="post" onsubmit="disableButton()">
            <h1>Modifier produit</h1>
            <div class="form-floating col-md-12">
                <input type="text" name="productName" class="form-control field-long" id="floatingInput"
                       placeholder="Nom du produit" value="{{ product.name }}"/>
                <label for="floatingInput">Nom du produit</label>
            </div>
            <div class="form-floating col-md-12">
                <input type="text" name="productStock" class="form-control" id="floatingInput"  placeholder="Quantité en stock" value={{ product.quantityStock }} />
                <label for="floatingInput">Quantité en stock</label>
            </div>
            <h5>Tarification</h5>
            <div class="form-floating col-md-6">
                <input type="text" name="memberPrice" class="form-control" id="floatingInput" placeholder="Prix Membres" value={{ memberPrice }} />
                <label for="floatingInput">Prix Membres</label>
            </div>
            <div class="form-floating col-md-6">
                <input type="text" name="studentPrice" class="form-control" id="floatingInput" placeholder="Prix Etudiant" value={{ studentPrice }} />
                <label for="floatingInput">Prix Etudiant</label>
            </div>
            <h5>Type de produits</h5>
            <div class="form-group col-md-12" >
                <select name="productType" class="form-control linked-select">
                    {% for productType in productTypes %}
                        <option {% if productType == product.productType %} selected {% endif %}>
                            {{ productType }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <button class="btn btn-primary disableable" type="submit" onclick="return verifyProduct()">
                Modifier
            </button>
        </form>
    </div>
{% endblock %}