{% extends 'base.html.twig' %}

{% block title %}
    Modifier un produit
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/product/product.css') }}">
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('script/product/addEditVerifications.js') }}"></script>
    <script type="text/javascript" src="{{ asset('script/generic/formGenericFunction.js') }}"></script>
{% endblock %}

{% block body %}
    <div class="flex-vertical flex-centered main-block">
        <h2 class="title-1">
            Modification de Produit
        </h2>
        <div>
            {% if message != "" %}
                <div class="form-group flex-horizontal flex-centered">
                    <div class="message message-incorrect">
                        Erreur dans la saisie des informations
                    </div>
                </div>
            {% endif %}
        </div>
        {# Form Start #}
        <form method="post" class="flex-vertical flex-centered" id="form-product" onsubmit="disableButton()" enctype="multipart/form-data">
            <div class="form-group">
                <label class="input-label">Nom du produit</label>
                <input type="text" name="productName" class="form-input" value="{{ product.name }}">
            </div>
            <div class="form-group">
                <label class="input-label">Quantité en stock</label>
                <input type="text" name="productStock" class="form-input" value="{{ product.quantityStock }}">
            </div>
            <div id="active-product-block">
                <input type="checkbox" name="isActive" value="true" {% if product.active %} checked {% endif %}>
                <label for="statusCheckbox">Produit actif</label>
            </div>
            <div class="form-group">
                <label class="input-label">Modification de l'image</label>
                <select name="pictureState" class="form-input">
                    <option value="keep" selected>
                        Conserver l'image actuelle
                    </option>
                    <option value="edit">
                        Modifier l'image
                    </option>
                </select>
            </div>
            <div class="form-group" id="imageArea" style="visibility: hidden;">
                <label class="input-label">Image du produit</label>
                <div class="width-fit-content">
                    <input type="file" name="productPicture" id="productPicture" class="form-input" accept=".png, .jpeg, .jpg, .gif"/>
                </div>
            </div>
            <p class="form-group-title flex-align-self-left">
                Tarification
            </p>
            <div class="block-form-group flex-horizontal">
                <div class="form-group">
                    <label class="input-label">Prix Membre</label>
                    <input type="text" name="memberPrice" class="form-input" value="{{ memberPrice }}">
                </div>
                <div class="form-group">
                    <label class="input-label">Prix Etudiant</label>
                    <input type="text" name="studentPrice" class="form-input" value="{{ studentPrice }}">
                </div>
            </div>
            <div class="form-group">
                <label class="input-label">Type de produit</label>
                <select name="productType"  class="form-input">
                    {% for productType in productTypes %}
                        <option {% if productType is same as(product.productType) %} selected {% endif %} >
                            {{ productType.value }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit" class="btn btn-primary disableable" onclick="return verifyProduct()">
                Modifier
            </button>
        </form>
        {# End Form #}
        <a href="{{ path("menuProduct") }}">
            <img src="{{ asset('img/icons/back.png') }}" class="back-arrow-pages">
        </a>
    </div>
{% endblock %}