{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link href="{{ asset('style/product/product.css') }}" rel="stylesheet" type="text/css"/>
{% endblock %}

{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script type="text/javascript" src="{{ asset('script/product/ajaxMenuProduct.js') }}"></script>
{% endblock %}

{% block title %}
    Nos Produits
{% endblock %}


{% block body %}
    {% if message %}
        <div class="flex-horizontal flex-centered">
            <div class="message message-information">
                {{ message }}
            </div>
        </div>
    {% endif %}
    <div class="main-block flex-vertical flex-centered">
        <div>
            <h1 class="title">
                Nos Produits
            </h1>
        </div>
        {% if is_granted("ROLE_ASSOC") %}
            <div class="">
                <a href="{{ path('createProduct') }}">
                    <button class="btn btn-primary">
                        Ajouter
                    </button>
                </a>
            </div>
            <br>
        {% endif %}

        <div class="list-card flex-horizontal flex-centered flex-overflow">
            {% for product in products %}
                <div class="card">
                    <img src={{ product.imageLink }}>
                    <div class="card-text">
                        <input type="hidden" id="idProduct" value="{{ product.id }}">
                        <div class="card-title">
                            <p>
                                {{ product.name }}
                            </p>
                        </div>
                        {% if product.quantityStock == 0 %}
                            <p class="product-quantity">
                                <b style="color:red;">
                                    Stock épuisé
                                </b>
                            </p>
                        {% else %}
                            <p class="product-quantity">
                                Quantité en stock : {{ product.quantityStock }}
                            </p>
                        {% endif %}
                        <div class="product-price">
                            <p>
                                Prix :
                                {% for price in product.prices %}
                                    {% if price.clientType == clientTypeActual%}
                                        {{ price.price }}€
                                    {% endif %}
                                {% endfor %}
                            </p>
                        </div>
                        <div class="flex-horizontal flex-centered card-buttons">
                            {% if is_granted("ROLE_ASSOC") %}
                                <a href="{{ path("editProduct", {"id": product.id}) }}">
                                    <button class="btn btn-secondary">
                                        Modifier
                                    </button>
                                </a>
                                <a id="toDelete">
                                    <button class="btn btn-secondary">
                                        Supprimer
                                    </button>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}