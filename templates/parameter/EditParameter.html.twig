{% extends 'base.html.twig' %}

{% block title %}
    Modification du parametrage
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('script/parameter/parameter.js') }}"></script>
    <script type="text/javascript" src="{{ asset('script/generic/formGenericFunction.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/parameter/parameter.css') }}">
{% endblock %}

{% block body %}
    <div class="flex-vertical flex-centered main-block">
        <h2 class="title-1">
            Modification du Parametrage
        </h2>
        <div>
            {% if message != "" %}
                <div class="form-group flex-horizontal flex-centered">
                    <div class="message message-incorrect">
                        {{ message }}
                    </div>
                </div>
            {% endif %}
        </div>
        <form method="post" class="flex-vertical flex-centered" id="form-parameter" onsubmit="disableButton()" enctype="multipart/form-data">
            <p class="form-group-title flex-align-self-left">
                General
            </p>
            <div class="block-form-group">
                <div class="form-group">
                    <label class="input-label">Nom de l'association</label>
                    <input type="text" name="associationName" value="{{ parameter.associationName }}" class="form-input">

                </div>
                <div class="form-group">
                    <label class="input-label">Logo de l'association</label>
                    <div class="width-fit-content">
                        <input type="file" name="associationLogo" id="associationLogo" class="form-input" accept=".png, .jpeg, .jpg, .gif"/>
                    </div>
                </div>
            </div>

            <p class="form-group-title flex-align-self-left">
                Accueil
            </p>
            <div class="flex-horizontal block-form-group">
                <div class="form-group">
                    <label class="input-label">Image page d'accueil</label>
                    <div class="width-fit-content">
                        <input type="file" name="homeImage" id="homeImage" class="form-input" accept=".png, .jpeg, .jpg, .gif"/>
                    </div>
                </div>
                <div class="form-group">
                    <label class="input-label">Description</label>
                    <textarea rows="5" class="form-input" name="associationDescription">{{ parameter.associationDescription }}</textarea>
                </div>
            </div>

            <p class="form-group-title flex-align-self-left">
                Fonctionnalités
            </p>
            <div class="flex-horizontal block-form-group">
                <div class="form-group">
                    <label class="input-label">Post activé</label>
                    <input type="checkbox" name="postActivated" {% if parameter.postActivated %} checked {% endif %} class="flex-align-self-left">
                </div>
                <div class="form-group">
                    <label class="input-label">Cotisant activé</label>
                    <input type="checkbox" name="cotisantActivated" {% if parameter.cotisantActivated %} checked {% endif %} class="flex-align-self-left">
                </div>
            </div>

            <p class="form-group-title flex-align-self-left">
                Fidelité
            </p>
            <div class="flex-horizontal block-form-group">
                <div class="form-group">
                    <label class="input-label">Nombre point fidélité pour ajout sur le solde</label>
                    <input type="text" name="amountFidelityPointToExchange" value="{{ parameter.amountFidelityPointToExchange }}" class="form-input">
                    <p class="form-input-hint">
                        Defaut : 150 <br>
                        1€ dépensé = 10 points
                    </p>
                </div>
                <div class="form-group">
                    <label class="input-label">Montant ajouté sur le solde</label>
                    <input type="text" name="amountBalanceToAddAfterExchange" value="{{ parameter.amountBalanceToAddAfterExchange }}" class="form-input">
                    <p class="form-input-hint">
                        Defaut : 0.80€
                    </p>
                </div>
            </div>
            <button type="submit" class="btn btn-primary disableable" onclick="return verifyProduct()">
                Modifier
            </button>
        </form>
    </div>
{% endblock %}