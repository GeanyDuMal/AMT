{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link href="{{ asset('style/home/home_new.css') }}" rel="stylesheet"/>
    <link href="{{ asset('style/home/carousel.css') }}" rel="stylesheet"/>
{% endblock %}

{% block javascripts %}
    <script src="/script/home/home.js"></script>
    <script src="{{ asset('script/home/carousel.js') }}"></script>
    {# Bootstrap JS Import #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
    {# End Bootstrap JS Import #}
{% endblock %}

{% block title %}
    Home
{% endblock %}

{% block body %}
    {# Home Page #}

    {# Welcome title #}
    <h1 class="top-text">Bienvenue sur le site de l'AEDI !</h1>
    <h3 class="top-text-sub"><em>Tout ce qu'il te faut se trouve ici</em></h3>
    {# End Welcome title #}


    {# Carousel #}
     <section class="carousel">
        <button class="slide-arrow" id="slide-arrow-prev" onclick="switchCarouselItem()">
            &#8249;
        </button>
        <button class="slide-arrow" id="slide-arrow-next" onclick="switchCarouselItem()">
            &#8250;
        </button>

        <ul class="slides-container" id="slides-container">
            <li class="slide slide-active">
                <img src="/img/home/iut.jpg" alt="">
            </li>
            <li class="slide">
                <img src="/img/home/iut1.jpg" alt="">
            </li>
            <li class="slide">
                <img src="/img/home/iut2.jpg" alt="">
            </li>
        </ul>
     </section>
    {# End Carousel #}

    {# Intro #}
    <p class="body-text">
        Envie d'en apprendre un peu plus sur nous ?
        <br>
        ↓ C'est par ici ! ↓
    </p>
    {# End Intro #}

    {# Accordion #}
    <div class="accordion-general">
        <div class="accordion-item">
            <button class="accordion-button">
                A Propos
            </button>
            <div class="accordion-content">
                <p>
                    L'AEDI est une association étudiante, ayant pour but d'organiser des évènements au sein du Département Informatique.
                    <br><br>
                    Notre Local se trouve au fond du 3ème étage du bâtiment E, en E35
                    <br><br>
                    Venez nous rendre visite ! ;)
                </p>
            </div>
        </div>
        <div class="accordion-item">
            <button class="accordion-button">
                Nos Produits
            </button>
            <div class="accordion-content">
                <p>
                    Nos produits sont essentiellement des snacks (Oréo, Twix, Snickers...) et des boissons (Eau, Coca, Jus d'orange...)
                    <br>
                    <i>N'hésitez pas à <a href="{{ path("menuProduct") }}"  class="link-danger">consulter nos produits</a> ou <a href="{{ path("menuBlog") }}" class="link-danger">nos posts</a></i>
                    <br>
                    <br>
                    Des questions...?
                    <i><a href="mailto:assoc.aedi.metz@gmail.com" class="link-danger">Nous Contacter</a></i>
                    <br>
                </p>
            </div>
        </div>
        <div class="accordion-item active-accordion">
            <button class="accordion-button">
                Notre Adresse
            </button>
            <div class="accordion-content">
                <div class="mapouter">
                    <div class="gmap_canvas">
                        <iframe width="100%" height="300" id="gmap_canvas" src="https://maps.google.com/maps?q=iut%20metz%20saulcy&t=&z=13&ie=UTF8&iwloc=&output=embed" frameborder="0" scrolling="no" marginheight="0" marginwidth="0"></iframe>
                    </div>
                </div>
                <div>
                    <p>
                        L'institut universitaire de technologie de Metz est situé sur l’île du Saulcy ainsi qu’au Technopôle de Metz-Grigy. Il fait partie de l’université de Lorraine.
                    </p>
                    <em>57000 Metz, France </em>
                    <div>
                        <a href="http://iut-metz.univ-lorraine.fr" target="blank" class="link-danger">Visiter le site de l'IUT de Metz
                            <br><img src="http://iut-metz.univ-lorraine.fr/sites/default/files/inline-images/logo-iut-metz.png" alt="logo univ lorraine" style="width: 200px;height: auto;margin-top:10px;">
                        </a>
                    </div>
                    <div>
                        <p>
                            Vous pouvez créer un ticket sur <a href="https://github.com/GeanyDuMal/AEDI_Support/issues/new" target="new">
                                le support</a> du site si vous avez une requête ou un problème.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# End Accordion #}

    {# Script for the RGPD #}
    <script src="///www.lescigales.org/rgpd/rgpd.js?v=1" where="bottom" async defer></script>
    
    {# End Home Page #}
{% endblock %}

