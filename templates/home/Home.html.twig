{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link href="{{ asset('style/home/home.css') }}" rel="stylesheet"/>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('script/home/home.js') }}"></script>
{% endblock %}

{% block title %}
    Accueil
{% endblock %}

{% block body %}
    <h1 class="top-text">
        Bienvenue sur le site de votre association {% if parameter.associationName %}: {{ parameter.associationName }} {% endif %}
    </h1>

    <div class="flex-horizontal flex-centered block-image">
        {% if parameter.linkHomeImage %}
            <div class="image-home">
                <img src="{{ asset( parameter.linkHomeImage ) }}" alt="">
            </div>
        {% else %}
            <div class="image-home">
                <img src="{{ asset("img/home/placeholder.png") }}" alt="">
            </div>
        {% endif %}
    </div>


    <div class="home-text">
        {% if parameter.associationDescription %}
            <p>
                {{ parameter.associationDescription }}
            </p>
        {% endif %}
        <hr>
        <p>
            Vous pouvez créer un ticket sur <a href="https://github.com/GeanyDuMal/AEDI_Support/issues/new" target="new">
                le support</a> du site si vous avez une requête ou un problème.
        </p>
    </div>

    {# Script for the RGPD #}
    <script src="///www.lescigales.org/rgpd/rgpd.js?v=1" where="bottom" async defer></script>
    
    {# End Home Page #}
{% endblock %}