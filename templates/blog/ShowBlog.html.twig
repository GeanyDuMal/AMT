{% extends 'base.html.twig' %}

{% block title %}
    Blog : {{ blog.title }}
{% endblock %}

{% block stylesheets %}
    {# Bootstrap CSS Import #}
    <link href="/style/bootstrap.min.css" rel="stylesheet"/>
    <link rel='stylesheet' href='https://use.fontawesome.com/releases/v5.0.12/css/all.css'>
    {# End Bootstrap CSS Import #}

    <link rel='stylesheet' href="{{ asset('style/client/index.css') }}">
    <link rel='stylesheet' href="{{ asset('style/blog/css/blog.css') }}">
    <style>
        .center {
            display: block;
            margin-left: auto;
            margin-right: auto;
            width: 50%;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-5 ">
        <div class="block row g-2 " method="post" >
            <h1>{{ blog.title }}</h1>
            <div class="col-md-12">
               <img style="max-width:50%;" class="img-responsive center"  src={{ blog.imageLink }}>
            </div>
            <div class="col-md-12">
                <p>
                    Post créé le {{ blog.creationDate | date('d/m/Y') }}
                </p>
                <h3>Contenu :</h3>
                <p>
                    {{ blog.description }}
                </p>
            </div>
        </div>
    </div>
{% endblock %}