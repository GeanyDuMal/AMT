{% extends 'base.html.twig' %}

{% block title %}
    Blog : {{ blog.title }}
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/blog/blog.css') }}">
{% endblock %}

{% block body %}
    <div class="flex-vertical flex-centered">
        <div class="flex-vertical flex-centered show-blog-main">
            <h1>{{ blog.title }}</h1>
            <div class="show-post-image-container">
                <img src={{ blog.imageLink }}>
            </div>
            <div class="flex-vertical show-blog-text">
                <p>
                    Post créé le {{ blog.creationDate | date('d/m/Y') }}
                </p>
                <h3>Contenu :</h3>
                <p>
                    {{ blog.description }}
                </p>
            </div>
        </div>
        <a href="{{ path("menuBlog") }}">
            <img src="{{ asset('img/icons/back.png') }}" class="back-arrow-pages">
        </a>
    </div>
{% endblock %}