{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link href="/style/blog/css/blog.css" rel="stylesheet"/>

    {# Google Fonts #}
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
    {# End Google Fonts #}
{% endblock %}

{% block javascripts %}
    {# Bootstrap JS Import #}
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    {# End Bootstrap JS Import #}

    <script src="/script/blog/ajaxMenuBlog.js"></script>
{% endblock %}

{% block title %}Blog{% endblock %}

{% block body %}
    {% if message %}
        <div class="form-group flex-horizontal flex-centered">
            <div class="message message-incorrect">
                {{ message }}
            </div>
        </div>
    {% endif %}
    <div class="main-block flex-vertical flex-centered">
        <div>
            <h1 class="title">
                Posts & Events
            </h1>
        </div>
        {% if is_granted("ROLE_ASSOC") %}
        <div class="">
            <a href="{{ path('createBlog') }}">
                <button class="btn btn-primary">
                    Ajouter
                </button>
            </a>
        </div>
        <br>
        {% endif %}

        <div class="list-card flex-horizontal flex-centered flex-overflow">
        {% for blog in blogs  %}
                <div class="card">
                    <div class="card-subblock">
                        <div class="flex-vertical flex-centered">
                            <img src={{ blog.imageLink }}>
                        </div>
                        <div class="card-text">
                            <div id="idBlog" hidden>{{ blog.id }}</div>
                            <div class="card-title">
                                <p>
                                    {{ blog.title }}
                                </p>
                            </div>
                            <div>
                                <p class="card-text-description">
                                    {{ blog.description|slice(0, 40) }}...
                                </p>
                            </div>
                            <a href="{{ url('showBlog',{id:blog.id}) }}" >
                                <button class="btn btn-primary">
                                    Lire plus
                                </button>
                            </a>
                            {% if is_granted("ROLE_ASSOC") %}
                                <a href="{{ path("editBlog", {"id": blog.id}) }}" class="btn btn-outline-primary rounded-0 float-end">Modifier</a>
                                <a id="toDelete" class="btn btn-outline-primary rounded-0 float-end">Supprimer</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
        {% endfor %}
        </div>
    </div>

{% endblock %}
