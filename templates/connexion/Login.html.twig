{% extends 'base.html.twig' %}

{% block title %}
    Connexion
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/style/connexion/connexion.css">
{% endblock %}

{% block javascripts %}
    <script src="/script/connexion/login.js"></script>
    <script src="/script/generic/formGenericFunction.js"></script>
{% endblock %}

{% block body %}
    <div class="flex-vertical flex-centered">
        {% block navbar %}
        {% endblock %}

        {# Top bar #}
        <div class="navbar top">
            <a href="{{ path("home") }}">
                <img class="back-arrow" src="\img\icons\back_w.png" alt="back arrow">
            </a>
            <h1 class="top-text">Connexion</h1>
            <div></div>
        </div>
        {# End Top bar #}

        <div class="container">
            <form action="" class="flex-vertical flex-centered" method="post" id="form_login" onsubmit="disableButton()">
                <img src="/img/connexion/user.png" alt="" id="img_profile">

                <div class="form-group">
                    <label for="login" class="input-label">Login</label>
                    <input type="text" name="login" class="input form-input" value="{{ lastLogin }}">
                </div>

                <div class="form-group">
                    <label for="password" class="input-label">Mot De Passe</label>
                    <input type="password" name="password" class="input form-input">
                </div>
                {# End Form Inputs with floatig label #}

                {# Message d'erreur #}
                {% if error %}
                    <div class="alert alert-dismissible alert-primary">
                        Login ou mot de passe incorrect
                    </div>
                {% endif %}
                {# End erreur #}

                <div class="flex-vertical centered-flex">
                    <button type="submit" class="btn btn-primary disableable" onclick="return verifyInputLogin()">
                        Se Connecter
                    </button>
                </div>
            </form>

            <div class="text_bottom">
                Pas encore Client ? <a href="{{ path('signin') }}">Inscrivez vous</a>
            </div>
            <div class="text_bottom">
                <a href="{{ path('passwordForgot') }}">Mot de passe oublié ?</a>
            </div>
        </div>
    </div>
{% endblock %}
