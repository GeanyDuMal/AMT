{% extends 'base.html.twig' %}

{% block title %}
    Profil
{% endblock %} 

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/connexion/connexion.css') }}">
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('script/connexion/profile.js') }}"></script>
    <script src="{{ asset('script/generic/formGenericFunction.js') }}"></script>
{% endblock %}

{% block navbar %}
{% endblock %}
    
{% block body %}
    <div class="flex-vertical flex-centered">
        {# Top bar #}
        <div class="navbar navbar-replace top">
            <a href="{{ path("home") }}">
                <img class="back-arrow-sidebar" src="{{ asset('img/icons/back_w.png') }}" alt="back arrow">
            </a>
            <h1 class="navbar-replace-title">Profil</h1>
            <div class="back-arrow-sidebar"></div>
        </div>
        {# End Top bar #}

        <div class="flex-vertical flex-centered main-block">
            <div class="hiding">
                <div class="flex-vertical flex-centered">
                    <img src="{{ asset('img/connexion/user.png') }}" alt="" id="img-profile">
                    <h1 class="profile-title">
                        Bienvenue {{ user.name }} {{ user.firstName }} / {{ user.login }}
                    </h1>

                    {% if fail %}
                        <h2 class="message message-incorrect">
                            Votre mot de passe est incorrect
                        </h2>
                    {% elseif edit %}
                        <h2 class="message message-correct">
                            Modification effectuée avec succès
                        </h2>
                    {% endif %}

                    {# Client Informations #}
                    <table class="table-information">
                        <tr>
                            <td>Solde :</td>
                            <td>{{ user.balance }} €</td>
                        </tr>
                        <tr>
                            <td>Compteur de fidelité :</td>
                            <td>{{ user.fidelityPoint }}</td>
                        </tr>
                        <tr>
                            <td>Statut :</td>
                            <td>{{ user.clientType.value }}</td>
                        </tr>

                    </table>
                    {# End Client Informations #}

                    {# Points #}
                    <h3>
                        Rappel
                    </h3>
                    <div class="flex-vertical flex-centered">
                        <p class="text-small">
                            <em> {{ parameter.amountFidelityPointToExchange }} point de fidelité = {{ parameter.amountBalanceToAddAfterExchange }}€ </em>
                        </p>
                        <p class="text-small">
                            Vos informations tels que votre login ou votre mot de passe sont privées.<br>
                            Veuillez ne jamais les divulger.
                        </p>
                    </div>
                    {# End Points #}

                    {# Options #}
                    <div class="flex-horizontal flex-centered spacing flex-overflow">
                        <button class="btn btn-secondary" onclick="openCloseEditForm()">
                            Modifier le mot de passe
                        </button>
                        <a href="{{ path('logout') }}">
                            <button class="btn btn-primary disableable">
                                Se déconnecter
                            </button>
                        </a>
                        <a href="{{ path('deleteProfile') }}" >
                            <button class="btn btn-secondary disableable" onclick="return warningSuppressionAccount()">
                                Supprimer son compte
                            </button>
                        </a>
                    </div>
                    {# End Options #}
                </div>
            </div>
        </div>
        {# Edit Password #}
        <form class="flex-vertical flex-centered secondary-block" onsubmit="disableButton()" method="post" id="form-edit-password">
            <div class="edit-password">
                <div class="form-group">
                    <label for="password" class="input-label">Ancien mot de passe</label>
                    <input type="password" name="oldPassword" class="form-input">
                </div>

                <div class="form-group">
                    <label for="password" class="input-label">Nouveau mot de passe</label>
                    <input type="password" name="newPassword" class="form-input">
                    <ul class="list-ul">
                        <li>Au moins 5 caractères</li>
                        <li>Au moins 1 caractère spécial</li>
                    </ul>
                </div>

                <div class="form-group">
                    <label for="password" class="input-label">Confirmation du nouveau mot de passe</label>
                    <input type="password" name="confirmPassword" class="form-input">
                </div>

                <button type="submit" class="btn btn-primary disableable" onclick="return verifyInputEditPassword()">
                    Valider
                </button>
            </div>
        </form>
        {# End Edit Password #}
    </div>


{% endblock %}
