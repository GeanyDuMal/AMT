{% extends 'base.html.twig' %}

{% block title %}
    Mot de passe oublié
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/style/connexion/connexion.css">
    <link rel="stylesheet" href="/style/connexion/profile.css">

    {# Google Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
    {# End Google Fonts #}

{% endblock %}

{% block javascripts %}
    <script src="/script/connexion/profile.js"></script>
    <script src="/script/generic/formGenericFunction.js"></script>
{% endblock %}

{% block navbar %}
{% endblock %}

{% block body %}
    <div class="flex_vertical centered_flex principal_block">
        {# Top bar #}
        <div class="top">
            <h1 class="top-text">Mot de passe oublié</h1>
            <a href={{ path('home') }}>
                <img class="back-arrow" src="\img\icons\back_w.png" alt="back arrow"></a>
        </div>
        {# End Top bar #}

        {% if message != "" %}
            <div class="alert alert-dismissible alert-info fade show">
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <strong>{{ message }}</strong>
            </div>
        {% endif %}

        <form id="password_forgot_form" class="row g-2 flex_centered" action="" method="post" onsubmit="disableButton()">
            <div class="flex_vertical centered_flex">
                <img src="/img/connexion/user.png" alt="" id="img_profile">
            </div>
            <div class="form-floating col-md-6">
                <input type="text" name="clientName" class="form-control field-long" id="floatingInput" placeholder="Nom du Client"/>
                <label for="floatingInput">Nom du Client</label>
            </div>
            <div class="form-floating col-md-6">
                <input type="text" name="clientFirstName" class="form-control" id="floatingInput" placeholder="Prénom du Client"/>
                <label for="floatingInput">Prénom du Client</label>
            </div>
            <div class="form-floating col-md-12">
                <input type="text" name="clientLogin" class="form-control" id="floatingInput"  placeholder="Login du Client"/>
                <label for="floatingInput">Login du Client</label>
            </div>
            <div class="flex_vertical centered_flex">
                <button type="submit" class="btn btn-primary disableable">
                    Faire une demande de reinitialisation
                </button>
            </div>
        </form>
    </div>
{% endblock %}
