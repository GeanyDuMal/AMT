{% extends 'base.html.twig' %}

{% block title %}
    Mot de passe oublié
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/connexion/connexion.css') }}">
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('script/generic/formGenericFunction.js') }}"></script>
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
{% endblock %}

{% block navbar %}
{% endblock %}

{% block body %}
    <div class="flex-vertical flex-centered">
        {# Top bar #}
        <div class="navbar top">
            <a href="{{ path("home") }}">
                <img class="back-arrow" src="{{ asset('img/icons/back_w.png') }}" alt="back arrow">
            </a>
            <h1 class="top-text">Mot de passe oublié</h1>
            <div class="back-arrow"></div>
        </div>
        {# End Top bar #}

        {% if message != "" %}
            <div class="form-group flex-horizontal flex-centered">
                <div class="message message-incorrect">
                    {{ message }}
                </div>
            </div>
        {% endif %}

        <form id="password_forgot_form" class="flex-vertical flex-centered" action="" method="post" onsubmit="disableButton()">
            <img src="{{ asset('img/connexion/user.png') }}" alt="" id="img_profile">

            <div class="block-form-group flex-horizontal">
                <div class="form-group">
                    <label for="clientName" class="input-label">Nom du Client</label>
                    <input type="text" name="clientName" class="form-input">
                </div>
                <div class="form-group">
                    <label for="clientFirstName" class="input-label">Prénom du Client</label>
                    <input type="text" name="clientFirstName" class="form-input">
                </div>
            </div>
            <div class="form-group">
                <label for="clientLogin" class="input-label">Login du Client</label>
                <input type="password" name="clientLogin" class="form-input">
            </div>

            <div class="flex_vertical centered_flex">
                <button type="submit" class="btn btn-primary disableable">
                    Faire une demande de reinitialisation
                </button>
            </div>
        </form>
    </div>
{% endblock %}
