{% extends 'base.html.twig' %}

{% block title %}
    Inscription
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/connexion/connexion.css') }}">
{% endblock %}


{% block javascripts %}
    <script src="{{ asset('script/connexion/signin.js') }}"></script>
    <script src="{{ asset('script/generic/formGenericFunction.js') }}"></script>
{% endblock %}

{% block body %}
    <div class="flex-vertical flex-centered">
        {# Top bar #}
        {% block navbar %}{% endblock %}
        <div class="navbar top">
            <a href="{{ path("home") }}">
                <img class="back-arrow" src="{{ asset('img/icons/back_w.png') }}" alt="back arrow">
            </a>
            <h1 class="top-text">Inscription</h1>
            <div class="back-arrow"></div>
        </div>
        {# End Top bar #}

        {# Form Start #}
        <form action="" method="post" class="flex-vertical flex-centered" id="form-signin" onsubmit="disableButton()">
            <img src="{{ asset('img/connexion/user.png') }}" alt="" id="img_profile">

            <div class="flex-horizontal block-form-group">
                <div class="form-group">
                    <label for="name" class="input-label">Nom</label>
                    <input type="text" name="name" class="form-input" value="">
                </div>
                <div class="form-group">
                    <label for="firstName" class="input-label">Prénom</label>
                    <input type="text" name="firstName" class="form-input" value="">
                </div>
            </div>

            <div class="form-group">
                <label for="login" class="input-label">Login</label>
                <input type="text" name="login" class="form-input" value="">
                <ul class="list-require">
                    <li>Au moins 5 caractères</li>
                </ul>
            </div>

            <div class="flex-horizontal block-form-group">
                <div class="form-group">
                    <label for="password" class="input-label">Mot De Passe</label>
                    <input type="password" name="password" class="form-input">
                    <ul class="list-require">
                        <li>Au moins 5 caractères</li>
                        <li>Au moins 1 caractère spécial</li>
                    </ul>
                </div>
                <div class="form-group">
                    <label for="confirmPassword" class="input-label">Confirmation</label>
                    <input type="password" name="confirmPassword" class="form-input">
                </div>
            </div>

            {% if message %}
                <div class="form-group flex-horizontal flex-centered">
                    <div class="message message-incorrect">
                        {{ message }}
                    </div>
                </div>
            {% endif %}

            <button type="submit" class="btn btn-primary disableable" onclick="return verifyInputSignin()">
                S'inscrire
            </button>

            <div class="flex-vertical">
                <p class="text-block">
                    <em> 150 point de fidelité = 0.8€ </em>
                </p>
                <p>
                    Vos informations tels que votre login ou votre mot de passe sont privées.<br>
                    Veuillez ne jamais les divulger.
                </p>
            </div>
        </form>
        {# End Form #}

        <div class="text-bottom">
            Déja Client ? <a href="{{ path('login') }}">Connectez vous</a>
        </div>
    </div>
{% endblock %}
