{% extends 'base.html.twig' %}

{% block title %}Paiement{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/style/bootstrap.css">
    <link rel="stylesheet" href="/style/ordered/create.css">
    <link rel="stylesheet" href="/style/ordered/payment.css">
{% endblock %}

{% block javascripts %}
    <script src="/script/ordered/paymentOrdered.js"></script>
    <script src="/script/generic/formGenericFunction.js"></script>
{% endblock %}

{% block body %}
      <div class="flex_vertical centered_flex_vertical">
            {% if client %}
                  <div class="block_client">
                        <h2>
                              {{ client.name }} {{ client.firstName }}
                        </h2>
                        <div>
                              Point de Fidelité : {{ client.fidelityPoint }}
                        </div>
                        <div>
                            Solde : {{ client.balance }}
                        </div>
                  </div>
            {% endif %}
            
            <div class="block_all_product flex_horizontal centered_flex_horizontal">
            {% for product in listProduct %}
                  <div class="block_product">
                        <h2>
                              {{ product.name }}
                        </h2>
                        <div>
                              Quantité : {{ productQuantity[product.id] }} | Prix Unitaire : {{ montantProduct[product.id]/productQuantity[product.id] }}€
                        </div>
                        <div>
                              
                        </div>
                  </div>
            {% endfor %}
            </div>
            <h2>
                  Montant total : {{ montantTotal }}€
            </h2>
            <form method="post" class="block_button_payment" onsubmit="disableButton()">

                  {% for paymentType in paymentTypeList %}
                        <button type="submit" name="payement_type" value="{{ paymentType }}" class="btn btn-primary" onclick="return preventPayment()">
                            {{ paymentType }}
                            {% if paymentType == "Carte Bancaire" %}
                                <br> + {{ ((montantTotal//2)+1) * 5 }}cts
                            {% endif %}
                        </button>
                  {% endfor %}
            </form>
            <a href="{{ path("createOrdered") }}">
                  <img src="/img/icons/back.png" class="img" alt="" srcset="">    
            </a>
      </div>
{% endblock %}
