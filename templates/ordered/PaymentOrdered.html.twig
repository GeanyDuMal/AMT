{% extends 'base.html.twig' %}

{% block title %}Paiement{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/ordered/ordered.css') }}">
{% endblock %}

{% block javascripts %}
    <script src="{{  asset('script/ordered/paymentOrdered.js') }}"></script>
    <script src="{{  asset('script/generic/formGenericFunction.js') }}"></script>
{% endblock %}

{% block body %}
      <div class="flex-vertical flex-centered">
            {% if client %}
                  <div class="block_client">
                        <h2>
                              {{ client.name }} {{ client.firstName }}
                        </h2>
                        <div>
                              Point de Fidelité : {{ client.fidelityPoint }}
                        </div>
                        <div>
                            Solde : {{ client.balance }}
                        </div>
                  </div>
            {% endif %}
            
            <div class="list-card flex-horizontal flex-overflow flex-centered">
            {% for product in listProduct %}
                  <div class="card">
                      <div class="card-text">
                          <p class="card-title">
                              {{ product.name }}
                          </p>
                          <div>
                              Quantité : {{ productQuantity[product.id] }} |
                              Prix Unitaire : {{ montantProduct[product.id]/productQuantity[product.id] }}€
                          </div>
                      </div>
                  </div>
            {% endfor %}
            </div>
            <h2>
                  Montant total : {{ montantTotal }}€
            </h2>
            <form method="post" class="flex-horizontal flex-centered tab-button-payment" onsubmit="disableButton()">
                  {% for paymentType in paymentTypeList %}
                        <button type="submit" name="payement_type" value="{{ paymentType }}" class="btn btn-primary" onclick="return preventPayment()">
                            {{ paymentType }}
                            {% if paymentType == "Carte Bancaire" %}
                                <br> + {{ ((montantTotal//2)+1) * 5 }}cts
                            {% endif %}
                        </button>
                  {% endfor %}
            </form>
          <a href="{{ path("createOrdered") }}">
              <img src="{{ asset('img/icons/back.png') }}" class="back-arrow-pages">
          </a>
      </div>
{% endblock %}
