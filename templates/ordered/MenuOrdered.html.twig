{% extends 'base.html.twig' %}

{% block title %}Menu Commande{% endblock %}

{% block stylesheets %}
	{# CSS pour les tableaux  #}
	<link rel='stylesheet' href="https://cdn.datatables.net/1.11.3/css/jquery.dataTables.min.css">
	<link rel='stylesheet' href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.dataTables.min.css">
	<link rel='stylesheet' href="{{ asset('style/base/table.css') }}">

	<link rel="stylesheet" href="{{ asset('style/ordered/ordered.css') }}">
{% endblock %}

{% block javascripts %}
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
	<script type="text/javascript" src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>
	
	<script src="{{ asset('script/ordered/menuOrdered.js') }}"></script>
{% endblock %}

{% block body %}
	<div class="main-block flex-vertical flex-centered">
		<h2 class="title-1">
			Liste des commandes
		</h2>
		<div>
			{% if message != "" %}
				<div class="flex-horizontal flex-centered">
					<div class="message message-incorrect">
						{{ message }}
					</div>
				</div>
			{% endif %}
		</div>
		<div class="flex-align-self-left">
			<a href="{{ path('createOrdered') }}">
				<button class="btn btn-primary">
					Ajouter
				</button>
			</a>
		</div>
		{% if orderedList|length > 0 %}
			<table id="ordered-table" class="table">
				<thead>
					<tr>
						<th>N° </th>
						<th class="hide-phone">Date et Heure</th>
						<th>Nom Client</th>
						<th>Statut Commande</th>
						<th>Details</th>
					</tr>
				</thead>
				<tbody>
					{% for ordered in orderedList %}
						<tr>
							<td>
								{{ ordered.id }}
							</td>
							<td class="hide-phone">
								{{ ordered.orderedAt | date('d/m/Y à H:i:s') }}
							</td>
							{% if ordered.client %}
								<td>
									{{ ordered.client.name }} {{ ordered.client.firstName }}
								</td>
							{% else %}
								<td>
									Client non renseigné
								</td>
							{% endif %}
							<td>
								{{ ordered.status.value }}
							</td>
							<td>
								<a href="{{ path("showOrdered",{idOrder: ordered.id}) }}">
									<button class="btn btn-secondary">
										Info
									</button>
								</a>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		{% else %}
			<div class="flex-horizontal flex-centered">
				<div class="message message-incorrect">
					Il n'y a pas encore de commande.
				</div>
			</div>
		{% endif %}
	</div>
{% endblock %}
