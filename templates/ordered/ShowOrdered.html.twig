{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/ordered/ordered.css') }}">
{% endblock %}

{% block javascripts %}
	<script src="/script/ordered/detailOrdered.js"></script>
{% endblock %}

{% block title %}Detail de la commande{% endblock %}

{% block body %}
      <div class="flex-vertical flex-centered">
            <h3>
                  Commande n° {{ ordered.id }} 
                  {% if ordered.client %}
                        réalisée par {{ ordered.client.name }} {{ ordered.client.firstName }}
                  {% endif %}
            </h3>
            <h3>
                  le {{ ordered.orderedAt | date('d/m/Y à H:i:s') }}
            </h3>
            <h3>
                  Commande de type {{ ordered.clientTypeAtOrder.value }} reglé avec {{ ordered.paymentType.value }}
            </h3>
            <h3>
                  Commande en statut {{ ordered.status }}
            </h3>
            <div class="list-card flex-horizontal flex-centered flex-overflow">
                  {% for purchase in ordered.purchases %}
                        <div class="card">
                              <div class="card-text">
                                    <p class="card-title">
                                          {{ purchase.product.name }}
                                    </p>
                                    <div>
                                          Quantité : {{ purchase.quantity }}
                                    </div>
                                    <div>
                                          Prix unitaire : {{ purchase.unitaryPrice|number_format(2,'.') }}€
                                    </div>
                                    <div>
                                          Prix total : {{ (purchase.unitaryPrice * purchase.quantity)|number_format(2,'.') }}€
                                    </div>
                              </div>
                        </div>
                  {% endfor %}
            </div>
            <h3>
                  Montant total : {{ montantTotal }}€
            </h3>
            <div class="flex-horizontal flex-centered">
                  <a href="{{ path("menuOrdered") }}">
                        <img src="{{ asset('img/icons/back.png') }}" class="back-arrow-pages">
                  </a>
                  <form method="post">
                        {% if is_granted("ROLE_TRESORIER") %}
                              {% if ordered.status == statusPaid or ordered.status == statusWaitingPayment %}
                                    <button type="submit" class="btn btn-primary" name="cancel" value="cancel" onclick="return confirmCancel()">Annuler</button>
                              {% endif %}
                              {% if ordered.status == statusPaid %}
                                    <button type="submit" class="btn btn-primary" name="refund" value="refund" onclick="return confirmRefund()">Rembourser</button>
                              {% endif %}
                        {% endif %}
                  </form>
            </div>
      </div>
{% endblock %}
