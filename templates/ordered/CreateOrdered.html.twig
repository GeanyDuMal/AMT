{% extends 'base.html.twig' %}

{% block title %}Effectuer une commande{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/ordered/ordered.css') }}">
{% endblock %}

{% block javascripts %}    
    <script src="{{  asset('script/ordered/createOrdered.js') }}"></script>
    <script src="{{  asset('script/generic/formGenericFunction.js') }}"></script>
{% endblock %}

{% block body %}
    <div class="flex-vertical flex-centered main-block">
        <h2 class="title">
            Création d'une Commande
        </h2>
        {% if message != "" %}
            <div class="form-group flex-horizontal flex-centered">
                <div class="message message-incorrect">
                    {{ message }}
                </div>
            </div>
        {% endif %}
        <form method="post" class="flex-vertical flex-centered" id="form-ordered" onsubmit="disableButton()">
            <select name="orderedClient" class="form-input" id="client-select">
                <option value="null">Choisir un Client</option>
                {% for client in clientList %}
                    <option value="{{ client.id }}">{{ client.name }} {{ client.firstName }}</option>
                {% endfor %}
            </select>
            <div class="flex-horizontal flex-overflow flex-centered list-card">
            {% for product in productList %}
                <div class="card">
                    <div class="card-text">
                        <p class="card-title">
                            {{ product.name }}
                        </p>
                        <div>
                            Disponible : <span class="quantity-product-available">{{ product.quantityStock }}</span>
                        </div>

                        <div class="flex-horizontal">
                            <div>
                                Commandé :
                            </div>
                            <input type="number" class="form-input-like-text quantity-ordered" name="quantityOrdered_{{ product.id }}" value="0">
                        </div>
                        <div class="card-buttons">
                            <div class="btn btn-primary btn-minus">-</div>
                            <div class="btn btn-primary btn-plus">+</div>
                        </div>
                    </div>
                </div>
            {% endfor %}
            </div>

            <div class="flex-vertical flex-centered">
                <button type="submit" class="btn btn-primary disableable" onclick="return checkQuantityInput()">
                    Valider la commande
                </button>
            </div>
            <a href="{{ path("home") }}">
                <img src="{{ asset('img/icons/back.png') }}" class="back-arrow-pages">
            </a>
        </form>
    </div>
{% endblock %}
