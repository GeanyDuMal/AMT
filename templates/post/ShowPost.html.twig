{% extends 'base.html.twig' %}

{% block title %}
    Post : {{ post.title }}
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/post/post.css') }}">
{% endblock %}

{% block body %}
    <div class="flex-vertical flex-centered">
        <div class="flex-vertical flex-centered show-post-main">
            <h1>{{ post.title }}</h1>
            <div class="show-post-image-container">
                <img src={{ post.imageLink }}>
            </div>
            <div class="flex-vertical show-post-text">
                <p>
                    Post créé le {{ post.creationDate | date('d/m/Y') }}
                </p>
                <h3>Contenu :</h3>
                <p>
                    {{ post.description }}
                </p>
            </div>
        </div>
        <a href="{{ path("menuPost") }}">
            <img src="{{ asset('img/icons/back.png') }}" class="back-arrow-pages">
        </a>
    </div>
{% endblock %}