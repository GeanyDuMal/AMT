{% extends 'base.html.twig' %}

{% block title %}
    Création d'un Post
{% endblock %}

{%  block javascripts %}
    <script type="text/javascript" src="{{ asset('script/post/addEditVerificationsPost.js') }}"></script>
    <script type="text/javascript" src="{{ asset('script/generic/formGenericFunction.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/post/post.css') }}">
{% endblock %}

{% block body %}
    <div class="flex-vertical flex-centered main-block">
        <h2 class="title-1">
            Création d'un Post
        </h2>
        <div>
            {% if message != "" %}
                <div class="form-group flex-horizontal flex-centered">
                    <div class="message message-incorrect">
                        Erreur dans la saisie des informations
                    </div>
                </div>
            {% endif %}
        </div>
        {# Form Start #}
        <form action="" method="post" class="flex-vertical flex-centered" id="form-post" onsubmit="disableButton()" enctype="multipart/form-data">
            <div class="form-group">
                <label class="input-label">Titre du Post</label>
                <input type="text" name="postTitle" class="form-input" value="">
            </div>
            <div class="form-group">
                <label class="input-label">Description</label>
                <textarea rows="5" class="form-input" name="postDescription" id="floatingTextarea2"></textarea>
            </div>
            <div class="form-group">
                <label class="input-label">Image du post</label>
                <div class="width-fit-content">
                    <input type="file" name="postPicture" id="postPicture" class="form-input" accept=".png, .jpeg, .jpg, .gif"/>
                </div>
            </div>
            <div class="form-group">
                <label class="input-label">Type de Post</label>
                <select name="postType"  class="form-input">
                    {% for postType in postTypes %}
                        <option> {{ postType.value }} </option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit" class="btn btn-primary disableable" onclick="return verifyPost()">
                Créer
            </button>
        </form>
        {# End Form #}
        <a href="{{ path("menuPost") }}">
            <img src="{{ asset('img/icons/back.png') }}" class="back-arrow-pages">
        </a>
    </div>
{% endblock %}