<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>
        {% block title %}
            Neutral Title
        {% endblock %}
    </title>

    {# Icons #}
    <link rel='stylesheet' href='https://use.fontawesome.com/releases/v5.0.12/css/all.css'>

    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
    <link href="{{ asset('style/base/base.css') }}" rel="stylesheet"/>

    {% block stylesheets %}
    {% endblock %}
</head>

<body>
    {# ---- Navbar ---- #}
    {% block navbar %}
        <div>
            <nav class="navbar">
                <button onclick="toggleNav()" type="button" id="burger-nav">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <a href="{{ path("home") }}">
                    <img src="{{ asset('img/logo_menu.png') }}" width="auto" height="50" alt="logo-menu">
                </a>

                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <a href="{{ path("profile") }}">
                        Profil
                    </a>
                {% else %}
                    <a href="{{ path("login") }}">
                        Se connecter
                    </a>
                {% endif %}
            </nav>
        </div>

        {# hidden menu #}
        <div id="mySidebar" class="sidebar">
            <a class="close-btn" onclick="toggleNav()">
                <img class="back-arrow-sidebar" src="{{ asset('img/icons/back_w.png') }}" alt="Arrow">
            </a>
            <div class="sidebar-content">

                <div class="block-sidebar">
                    <a href="{{ path("home") }}">Accueil</a>
                    <a href="{{ path("menuProduct") }}">Nos&nbspProduits</a>
                    <a href="{{ path("menuBlog") }}">Posts&nbsp&&nbspEvents</a>
                </div>
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    {% if is_granted('ROLE_ASSOC') %}
                        <div class="block-sidebar">
                            <a href="{{ path("createOrdered") }}">Commander</a>
                        </div>
                        {% if is_granted('ROLE_SECRETAIRE') %}
                            <div class="block-sidebar">
                                <a href="{{ path("statistics") }}">Statistiques</a>
                                <a href="{{ path("menuClient") }}">Gestion&nbspClients</a>
                            </div>
                            {% if is_granted('ROLE_TRESORIER') %}
                                <div class="block-sidebar">
                                    <a href="{{ path("menuOrdered") }}">Gestion&nbspCommande</a>
                                </div>
                                {% if is_granted('ROLE_PRESIDENT') %}
                                    <div class="block-sidebar">
                                        <a href="{{ path("menuManagement") }}">Interface&nbspde&nbspGestion</a>
                                    </div>
                                {% endif %}
                            {% endif %}
                        {% endif %}
                    {% endif %}
                {% endif %}
                {# &nbsp <-- remplace le ' ' dans le menu lateral #}
            </div>
        </div>
        {# end hidden menu #}
    {% endblock %}
    {# ---- End Navbar ---- #}

    {% block body %}
    {% endblock %}

    {# Footer #}
    {% block footer %}
        <footer class="footer">
            <ul class="footer-link">
                <li>
                    <a href="https://www.linkedin.com/company/go-info/" target="new">
                        <span class="fab fa-linkedin-in icon "></span>
                    </a>
                </li>
                <li>
                    <a href="https://github.com/GeanyDuMal/AEDI_Support" target="new">
                        Support
                    </a>
                </li>
                <li>
                    <a href="https://discord.gg/RFCFkWPvsU" target="new">
                        <span class="fab fa-discord icon"></span>
                    </a>
                </li>
            </ul>
            <p>
                &copy {{ 'now' | date('Y') }} Copyright
            </p>
            {#  &copy; pour le c entouré de copyright #}
        </footer>
    {% endblock %}
    {# End Footer #}
</body>

{# Partie Script doit etre chargé apres le code
       car le code est géneré apres l'appel du JS #}

<script src="{{ asset('script/base/base.js') }}"></script>
{# Script pour SweetAlert #}
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

{% block javascripts %}
{% endblock %}

</html>