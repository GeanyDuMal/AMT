<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>
        {% block title %}
            Neutral Title
        {% endblock %}
    </title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>"/>
    {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
    {# Bootstrap CSS Import #}
    <link href="/style/bootstrap.min.css" rel="stylesheet"/>
    {# Icons #}
    <link rel='stylesheet' href='https://use.fontawesome.com/releases/v5.0.12/css/all.css'>
    {# End Bootstrap CSS Import #}
    <link href="/style/base/css/base.css" rel="stylesheet"/>

    {# Google Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
    {# End Google Fonts #}

    {# Icons #}
    <link rel='stylesheet' href='https://use.fontawesome.com/releases/v5.0.12/css/all.css'>

    {% block stylesheets %}
    {% endblock %}


</head>

<body>
    {# ---- Navbar ---- #}
    {% block navbar %}
        <div class="pos-f-t">
            <nav class="navbar navbar-dark position-fixed">
                <button onclick="openNav()" class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarToggleExternalContent" aria-controls="navbarToggleExternalContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a href="{{ path("home") }}">
                    <img src="{{ asset('img/logo_texte_white.png') }}" width="auto" height="50" alt="logo-menu" border="0"></a>
                </a>

                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <a href="{{ path("profile") }}">
                        Profil
                    </a>
                {% else %}
                    <a href="{{ path("login") }}">
                        Se connecter
                    </a>
                {% endif %}
            </nav>
        </div>

        {% block sidebar %}
            {# hidden menu #}
            <div id="mySidebar" class="sidebar">
                <a href="javascript:void(0)" class="closebtn" onclick="closeNav()">
                    <img style="margin-top: 1rem;" src="/img/icons/back_w.png" alt="Arrow" width="auto" height="50"></a>
                    <div style="margin-right: 1em;">

                        <div class="block_nav">
                            <a href="{{ path("home") }}">Accueil</a>
                            <a href="{{ path("menuProduct") }}">Nos&nbspProduits</a>
                            <a href="{{ path("menuBlog") }}">Posts&nbsp&&nbspEvents</a>
                        </div>
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            {% if is_granted('ROLE_ASSOC') %}
                                <div class="block_nav">
                                    <a href="{{ path("createOrdered") }}">Commander</a>
                                </div>
                                {% if is_granted('ROLE_SECRETAIRE') %}
                                    <div class="block_nav">
                                        <a href="{{ path("statistics") }}">Statistiques</a>
                                        <a href="{{ path("menuClient") }}">Gestion&nbspClients</a>
                                    </div>
                                    {% if is_granted('ROLE_TRESORIER') %}
                                        <div class="block_nav">
                                            <a href="{{ path("menuOrdered") }}">Gestion&nbspCommande</a>
                                        </div>
                                        {% if is_granted('ROLE_PRESIDENT') %}
                                            <div class="block_nav">
                                                <a href="{{ path("menuManagement") }}">Interface&nbspde&nbspGestion</a>
                                            </div>
                                        {% endif %}
                                    {% endif %}
                                {% endif %}
                            {% endif %}
                        {% endif %}
                        {# &nbsp <-- remplace le ' ' dans le menu lateral #}
                    </div>
                </div>
                {# end hidden menu #}
            {% endblock %}
        {% endblock %}
        {# ---- End Navbar ---- #}

    {% block body %}
    {% endblock %}

    {# Footer #}
    {% block footer %}
        <footer style="background-color: #212529;">
            <div class="container">
                <div class="grid">
                    <div class="column-xs-12">
                        <ul class="social">
                            <li>
                                <a href="https://www.linkedin.com/company/go-info/" target="new" rel="noopener noreferrer">
                                    <span class="fab fa-linkedin-in icon icon-red"></span>
                                </a>
                            </li>
                            <li>
                                <a href="https://github.com/GeanyDuMal/AEDI_Support" target="new" rel="noopener noreferrer" style="color: white">
                                    Support
                                </a>
                            </li>
                            <li>
                                <a href="https://discord.gg/RFCFkWPvsU" target="new" rel="noopener noreferrer">
                                    <span class="fab fa-discord icon"></span>
                                </a>
                            </li>
                        </ul>
                        <p class="copyright" style="color: white; padding-left:1.5rem;">&copy 2022 Copyright</p>
                        {#  &copy; pour le c entouré de copyright #}
                    </div>
                </div>
            </div>
        </footer>
    {% endblock %}
    {# End Footer #}
</body>


{# Partie Script doit etre chargé apres le code
       car le code est generé apres l'appel du JS #}

{# Script pour SweetAlert #}
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
{# Sidebar Script Import #}
<script src="/script/base/base.js"></script>
{% block javascripts %}
    {# Bootstrap JS Import #}
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
    {# End Bootstrap JS Import #}
{% endblock %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>

</html>
