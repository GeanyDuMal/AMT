{% extends 'base.html.twig' %}

{% block title %}Paiement{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/style/bootstrap.css">
    <link rel="stylesheet" href="/style/command/create.css">
    <link rel="stylesheet" href="/style/command/payment.css">
{% endblock %}

{% block javascripts %}
    <script src="/script/command/createCommand.js"></script>
{% endblock %}

{% block body %}
      <div class="flex_vertical centered_flex_vertical">
            {% if client %}
                  <div class="block_client">
                        <h2>
                              {{ client.name }} {{ client.firstName }} / {{ client.login }}
                        </h2>
                        <div>
                              Point de Fidelité : {{ client.fidelityPoint }}
                        </div>
                        <div>
                        Solde : {{ client.balance }}
                        </div>
                  </div>
            {% endif %}
            
            <div class="block_all_product flex_horizontal centered_flex_horizontal">
            {% for product in listProduct %}
                  <div class="block_product">
                        <h2>
                              {{ product.name }}
                        </h2>
                        <div>
                              Quantité : {{ productQuantity[product.id] }} | Prix Unitaire : {{ montantProduct[product.id]/productQuantity[product.id] }}€
                        </div>
                        <div>
                              
                        </div>
                  </div>
            {% endfor %}
            </div>
            <h2>
                  Montant total : {{ montantTotal }}€
            </h2>
            <form method="post" class="block_button_payment">

                  {% for paymentType in paymentTypeList %}
                        <button type="submit" name="payement_type" value="{{ paymentType.id }}" class="btn btn-primary" onclick="return preventPayment()">
                              {{ paymentType.name }}
                        </button>
                  {% endfor %}
            </form>
            <a href="{{ path("orderCreate") }}">
                  <img src="/img/icons/back.png" class="img" alt="" srcset="">    
            </a>
      </div>
{% endblock %}
