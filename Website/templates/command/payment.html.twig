{% extends 'base.html.twig' %}

{% block title %}Paiement{% endblock %}

{% block stylesheets %}
      <link rel="stylesheet" href="/style/bootstrap.css">
      <link rel="stylesheet" href="/style/command/create.css">
      <link rel="stylesheet" href="/style/command/payment.css">
{% endblock %}

{% block body %}
      {% for product in listProduct %}
            <div>
                  <div>
                        Nom du produit : {{ product.name }}
                  </div>
                  <div>
                        Quantity : {{ productQuantity[product.id] }}
                  </div>
                  <div>
                        Price : {{ montantProduct[product.id] }}€
                  </div>
            </div>
      {% endfor %}

      Montant total : {{ montantTotal }}€
      <form method="post">
            {% for paymentType in paymentTypeList %}
                  <button type="submit" name="payement_type" value="{{ paymentType.id }}" class="btn-primary">
                        {{ paymentType.name }}
                  </button>
            {% endfor %}
      </form>
{% endblock %}
