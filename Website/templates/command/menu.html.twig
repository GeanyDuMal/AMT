{% extends 'base.html.twig' %}

{% block title %}Menu Commande{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/style/command/menu.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.3/css/jquery.dataTables.min.css">
{% endblock %}

{% block javascripts %}
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
	<script src="/script/command/menuOrder.js"></script>
	<script src="/script/command/ajaxMenuCommand.js"></script>
{% endblock %}

{% block body %}
    	<div class="content">
		<div class="content-header">
			<h1>Liste des commandes</h1>
		</div>
		<div style="margin:5px">
			<a href="{{ path('orderCreate') }}" class="btn btn-success">Ajouter</a>
		</div>
		{% if message %}
			<div class="alert alert-dismissible alert-success fade show">
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				<strong>{{ message }}!</strong>
			</div>
		{% endif %}
		
		{% if orderList|length > 0 %}
		<table id="order_table" class="table table-striped">
			<thead bgcolor="#6cd8dc">
				<tr class="table-primary">
					<th>ID</th>
					<th>Date et Heure</th>
					<th>Nom Client</th>
					<th class="phone_hidden">Login</th>
					<th class="phone_hidden">Type Client</th>
					<th>Montant</th>
					{% if is_granted("ROLE_TRESORIER") %}
						<th>Supprimer</th>
					{% else %}
						<th>Demande Suppression</th>
					{% endif %}
				</tr>
			</thead>
			<tbody>
			{% for order in orderList %}
				<tr>
					<td id="idCell">
						{{ order.id }}
					</td>
					<td>
						{{ order.orderedAt|date('d/m/Y à H:i:s') }}
					</td>
					{% if order.client %}
						<td>
							{{ order.client.name }} {{ order.client.firstName }}
						</td>
						<td class="phone_hidden">
							{{ order.client.login }}
						</td>
						<td class="phone_hidden">
							{{ order.client.clientType.name }}
						</td>
					{% else %}
						<td>
							Client non renseigné
						</td>
						<td class="phone_hidden"></td>
						<td class="phone_hidden"></td>
					{% endif %}
						<td>
							{{ montantOrder[order.id] }}€
						</td>
					{% if is_granted("ROLE_TRESORIER") %}
						<td>
							<a id="toDelete" class="btn btn-danger" onclick="return warningDelete()">X</a>
						</td>
					{% else %}
						<td>
							<a id="askToDelete" class="btn btn-danger">Demande Suppression</a>
						</td>
					{% endif %}
					
				</tr>
			{% endfor %}
			
			</tbody>
		</table>
		{% else %}
			<div class="alert alert-info alert-dismissible fade show">
				<p>
					<strong>Info!</strong>
				</p> 
				<p>
					Il n'y a pas encore des Commandes.
				</p> 
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		{% endif %}
	</div>
{% endblock %}
