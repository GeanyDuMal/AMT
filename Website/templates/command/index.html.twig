{% extends 'base.html.twig' %}

{% block title %}Effectuer une commande{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/style/bootstrap.css">
{% endblock %}

{% block body %}
    <div>
        {% for product in productList %}
            <div>
                <img src="{{ product.imageLink }}" alt="">
                <div>
                    {{ product.name }}
                </div>
                <div>
                    {{ product.quantityStock }} 
                </div>
                <div class="qte_prod">
                    <div class="btn_gauche"></div>
                    <div class="compteur_produit">0</div>
                    <div class="btn_droite"></div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
