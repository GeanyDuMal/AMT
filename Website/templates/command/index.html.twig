{% extends 'base.html.twig' %}

{% block title %}Effectuer une commande{% endblock %}

{% block body %}
    <div>
        {% for product in productList %}
            <div>
                <img src="{{ product.imageLink }}" alt="">
                <div>
                    {{ product.name }}
                </div>
                <div>
                    {{ product.quantityStock }} 
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
