{% extends 'base.html.twig' %}

{% block title %}Effectuer une commande{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/style/bootstrap.css">
    <link rel="stylesheet" href="/style/ordered/create.css">
{% endblock %}

{% block javascripts %}    
    <script src="/script/ordered/createOrdered.js"></script>
{% endblock %}

{% block body %}    
    <form method="POST" class="flex_vertical centered_flex_vertical" id="form_command">
        <div class="flex_horizontal centered_flex_horizontal block_all_product">
        {% for product in productList %}
            <div class="block_product flex_vertical">
                <div class="flex_vertical">
                    <h3>
                        {{ product.name }}
                    </h3>
                    <div class="quantity_block">
                        <em>Quantité dispo : <span class="quantity_value">{{ product.quantityStock }}</em>
                    </div>
                </div>
                <div>
                    <input type="number" name="quantity_product_{{ product.id }}" class="input_quantity" step="1" value="0" min="0">
                    <div class="block_button">
                        <div class="btn btn-secondary btn_minus">-</div>
                        <div class="btn btn-secondary btn_plus">+</div>
                    </div>
                </div>
            </div>
        {% endfor %}
        </div>
        <div class="flex_vertical centered_flex_vertical block_bottom_create">
            {# SearchBar #}

            <input type="text" placeholder="Saisir un nom ...">
            {# Ancienne ChoiceBox #}
            <select name="client_commande" id="">
                <option value="null">Choisir un Client</option>
                {% for client in clientList %}
                    <option value="{{ client.id }}">{{ client.name }} {{ client.firstName }} / {{ client.login }}</option>
                {% endfor %}
            </select>

            <button type="submit" class="btn btn-primary" onclick="return checkQuantityInput()">Valider la commande</button>
        </div>
        <a href="{{ path("orderedMenu") }}">
            <img src="/img/icons/back.png" class="img" alt="" srcset="">    
        </a>
    </form>
{% endblock %}
