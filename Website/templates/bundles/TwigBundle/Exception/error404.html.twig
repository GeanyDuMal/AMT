<!DOCTYPE html>
<html lang="fr">

    <head>
        <meta charset="UTF-8">
        <title>
            {% block title %}
                404
            {% endblock %}
        </title>

        {% block stylesheets %}
            <link rel="stylesheet" href="/style/404_page/style.css">
        {% endblock %}

        {% block javascripts %}
            <script src='https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js'></script>
            <script src="/script/404_page/script.js"></script>
        {% endblock %}

    </head>

    <body>
        {% block body %}
            <div class="box">
                <div class="box__ghost">
                    <div class="symbol"></div>
                    <div class="symbol"></div>
                    <div class="symbol"></div>
                    <div class="symbol"></div>
                    <div class="symbol"></div>
                    <div class="symbol"></div>

                    <div class="box__ghost-container">
                        <div class="box__ghost-eyes">
                            <div class="box__eye-left"></div>
                            <div class="box__eye-right"></div>
                        </div>
                        <div class="box__ghost-bottom">
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                        </div>
                    </div>
                    <div class="box__ghost-shadow"></div>
                </div>

                <div class="box__description">
                    <div class="box__description-container">
                        <div class="box__description-title">Ooooops!</div>
                        <div class="box__description-text">Il semble que nous n'ayons pas pu trouver la page que vous cherchiez.</div>
                    </div>

                    <a href="javascript:history.go(-1)" class="box__button">Retour</a>

                </div>

            </div>
        {% endblock %}
    </body>

</html>
