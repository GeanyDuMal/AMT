{% extends 'base.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    <link rel='stylesheet' href="{{ asset('style/bootstrap.css') }}">
    <link rel='stylesheet' href="{{ asset('style/client/index.css') }}">
    <link href="/style/product/addproduct.css" rel="stylesheet" type="text/css"/>

    {# Bootstrap CSS Import #}
    <link href="https://bootswatch.com/_vendor/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet"/>
    {# Icons #}
    <link rel='stylesheet' href='https://use.fontawesome.com/releases/v5.0.12/css/all.css'>
    {# End Bootstrap CSS Import #}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript" src="{{ asset('script/product/addEditVerifications.js') }}"></script>
{% endblock %}
{% block body %}
    <div>
        <ul>
            {% if validationErrors is defined and validationErrors!="" %}
                {% for i in 0..validationErrors.count()-1 %}
                    <li>{{ validationErrors[i].message }}</li>
                {% endfor %}
            {% endif %}
        </ul>
    </div>
    <form id="product_form" action="" method="post">
        <ul class="form-style-1">
            <li><label>Nom du produit <span class="required">*</span></label><input type="text" name="productName"
                                                                                    class="field-long" placeholder="nom"
                                                                                    value={{ product.name }}></li>
            <li><label>Quantité en stock <span class="required">*</span></label><input type="text" name="productStock"
                                                                                       class="field-long"
                                                                                       placeholder="stock"
                                                                                       value={{ product.quantityStock }}>
            </li>
            <li><label>Lien de l'image </label><input type="text" name="imageLink" class="field-long"
                                                      placeholder="image" value={{ product.imageLink }}></li>
            <li>
                <label>Type de produits</label>
                <select name="productType" class="field-select">
                    {% for productType in productTypes %}
                        <option {% if productType.name==product.productType.name %} selected {% endif %} > {{ productType.name }} </option>
                    {% endfor %}
                </select>
            </li>
            <li><label>Tarification <span class="required">*</span></label><input type="text" name="memberPrice"
                                                                                  class="field-divided"
                                                                                  placeholder="Prix Membres"
                                                                                  value={{ memberPrice }}> <input
                        type="text" name="studentPrice" class="field-divided" placeholder="Prix Etudiant"
                        value={{ studentPrice }}></li>
            <li>
                <input class="btn-primary" type="submit" onclick="return verifyProduct()">
            </li>
        </ul>
    </form>
{% endblock %}