{% extends 'base.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    <link rel='stylesheet' href="{{ asset('style/bootstrap.css') }}">
    <link rel='stylesheet' href="{{ asset('style/client/index.css') }}">
    {# End Bootstrap CSS Import #}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript" src="{{ asset('script/product/addEditVerifications.js') }}"></script>
{% endblock %}
{% block body %}
    <div>
        <ul>
            {% if validationErrors is defined and validationErrors!="" %}
                {% for i in 0..validationErrors.count()-1 %}
                    <li>{{ validationErrors[i].message }}</li>
                {% endfor %}
            {% endif %}
            {% if productExistsError is defined and productExistsError!="" %}
                    {{ productExistsError }}
            {% endif %}
        </ul>
    </div>
    <div class="container mt-5 ">
    <form id="product_form" action="" class="row g-2" method="post">
        <h1>Nouveau produit</h1>
                <div class="form-floating col-md-12">
                    <input type="text" name="productName" class="form-control" id="floatingInput" class="field-long" placeholder="Nom du produit"/>
                    <label for="floatingInput">Nom du produit</label>
                </div>
            <div class="form-floating col-md-6">
                <input type="text" name="productStock" class="form-control" id="floatingInput" placeholder="Quantité en stock"/></li>
                <label for="floatingInput">Quantité en stock</label>
            </div>
            <div class="form-floating col-md-6">
                <input type="text" name="imageLink" class="form-control" id="floatingInput"  placeholder="Lien de l'image"/></li>
                <label for="floatingInput">Lien de l'image</label>
            </div>
        <h5>Tarification</h5>
            <div class="form-floating col-md-6">
                <input type="text" name="memberPrice" class="form-control" id="floatingInput" placeholder="Prix Membres"/>
                <label for="floatingInput">Prix Membres</label>
            </div>

            <div class="form-floating col-md-6">
                <input type="text" name="studentPrice" class="form-control" id="floatingInput" placeholder="Prix Etudiant"/>
                <label for="floatingInput">Prix Etudiant</label>
            </div>
        <h5>Type de produits</h5>
        <div class="form-group col-md-12" >
            <select name="productType" class="form-control linked-select">
                {% for productType in productTypes %}
                    <option> {{ productType.name }} </option>
                {% endfor %}
        </select>
        </div>
            <input class="btn btn-primary" value="Ajouter" type="submit" onclick="return verifyProduct()">


    </form>
    </div>
{% endblock %}