{% extends 'home/index.html.twig' %}

{% block stylesheets %}
    {# Style Base Import #}
    <link href="/style/base/css/base.css" rel="stylesheet"/>
    {# End Style Base Import #}

    <link href="/style/product/productList.css" rel="stylesheet"/>

    {# Bootstrap CSS Import #}
    <link href="https://bootswatch.com/_vendor/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet"/>
    {# Icons #}
    <link
            rel='stylesheet' href='https://use.fontawesome.com/releases/v5.0.12/css/all.css'>
    {# End Bootstrap CSS Import #}

    {# Google Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
    {# End Google Fonts #}
{% endblock %}

{% block title %}Nos Produits{% endblock %}


{% block body %}
    <div class="content-wrapper">
        <div class="content-header d-flex justify-content-center">
        {# d-flex justify-content-center : pour centrer à l'aide de bootstrap ;) #}
            <h1>Nos Produits</h1>
        </div>
        {% for product in products %}
            <div class="card mb-3 mx-auto">
                <div class="row g-0">
                    <div class="col-md-4">
                        <img src="{{ product.imageLink }}" class="img-fluid rounded-start" alt="">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title">{{ product.name }}</h5>
                            <p class="card-text">Quantité en stock : {{ product.quantityStock }}</p>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

    </div>
{% endblock %}