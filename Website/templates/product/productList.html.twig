{% extends 'base.html.twig' %}

{% block stylesheets %}
    {# Style Base Import #}
    <link href="/style/base/css/base.css" rel="stylesheet"/>
    {# End Style Base Import #}

    <link href="/style/product/css/productList.css" rel="stylesheet" type="text/css"/>

    {# Bootstrap CSS Import #}
    {# <link href="https://bootswatch.com/_vendor/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet"/> #}
    <link href="/style/bootstrap.css" rel="stylesheet"/>
    {# Icons #}
    <link rel='stylesheet' href='https://use.fontawesome.com/releases/v5.0.12/css/all.css'>
    {# End Bootstrap CSS Import #}
    {# Google Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
    {# End Google Fonts #}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript" src="{{ asset('script/product/deleteScript.js') }}"></script>
    {# Bootstrap JS Import #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
            crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
            integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
            crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"
            integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1"
            crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"
            integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM"
            crossorigin="anonymous"></script>
    {# End Bootstrap JS Import #}
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
{% endblock %}

{% block title %}Nos Produits{% endblock %}


{% block body %}
    {% if message %}
        <div class="alert alert-dismissible alert-success">
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            <strong>{{ message }}!</strong>
        </div>
    {% endif %}

    <div class="container">
        <div class="text-center my-5">
            <h1 class="page__title  ">Nos Produits</h1>
            <hr/>
        </div>
        {% if is_granted('ROLE_ASSOC') %}

            <div align="right">
                <a href="{{ path('add_product') }}" class="btn btn-primary rounded-0 button__add">Ajouter</a>
            </div>
        {% endif %}
        <div class="row">
            {% for product in products %}
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="card mb-5 shadow-sm">
                        <img src="{{ product.imageLink }}" class="img-fluid">
                        <div class="card-body">
                            <div class="card-title">
                                <h2>{{ product.name }}</h2>
                            </div>

                            <div class="card-text">

                                {% if product.quantityStock ==0 %}
                                    <p>
                                        {# Quantité en stock : {{ product.quantityStock }} &nbsp&nbsp&nbsp  #}
                                        <b style="color:red;">Stock épuisé</b>
                                    </p>

                                {% else %}
                                    <p>
                                        Quantité en stock : {{ product.quantityStock }}
                                    </p>
                                {% endif %}
                                <p>
                                    Prix : {{ productIdPrices[product.id] }} €
                                </p>
                            </div>
                            {% if is_granted('ROLE_ASSOC') %}
                                <a href="{{ url('edit_product',{id:product.id}) }}"
                                   class="btn btn-secondary rounded-0 float-end">Modifier</a>

                                <a id="toDelete" class="btn btn-primary rounded-0 float-end"
                                   data-id={{ product.id }}>Supprimer</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        {# End Products #}
        <div class="text-center my-5">
            <h1 class="page__title">Produits épuisés</h1>
            <hr/>
        </div>
        {# End Products #}
    </div>
{% endblock %}