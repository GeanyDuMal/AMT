{% extends 'base.html.twig' %}

{% block title %}
    Profil
{% endblock %} 

{% block stylesheets %}
    <link rel="stylesheet" href="/style/connexion/connexion.css">
    <link rel="stylesheet" href="/style/connexion/profile.css">

    
{% endblock %}

{% block javascripts %}
    <script src="/script/connexion/profile.js"></script>
{% endblock %}

{% block navbar %}
    {% endblock %}
    
{% block body %}
    <div class="flex_vertical centered_flex principal_block">
        {# Top bar #}
        <div class="top">
            <h1 class="top-text">Profil</h1>
            <a href="{{ path('home') }}">
            <img class="back-arrow" src="\img\icons\back_w.png" alt="back arrow"></a>
        </div>
        {# End Top bar #}

        <div class="hiding">
            <div class="client-info">
                <img src="/img/connexion/user.png" alt="" id="img_profile">

                    <h1 class="text_block">
                        Bienvenue {{ user.login }}
                    </h1>

                    {% if edit is same as("wrong_password") %}
                        <h2 class="message_information message_incorrect">
                            Votre mot de passe est incorrect
                        </h2>
                    {% elseif edit %}
                        <h2 class="message_information message_correct">
                            Modification effectuée avec succès
                        </h2>
                    {% endif %}

                    {# Client Informations #}
                    <table class="table_information">
                        <tr>
                            <td>Solde :</td>
                            <td>{{ user.balance }}
                                €</td>
                        </tr>
                        <tr>
                            <td>Compteur de fidelité :</td>
                            <td>{{ user.fidelityPoint }}</td>
                        </tr>
                        <tr>
                            <td>Statut :</td>
                            <td>{{ user.clientType.name }}</td>
                        </tr>

                    </table>
                    {# End Client Informations #}
                        <p class="d-flex justify-content-center" style="font-style">
                            150 point de fidelité = 0.8€
                        </p>

                    {# Options #}
                    <button class="btn btn-secondary" onclick="openCloseEditForm()">
                        Modifier le mot de passe
                    </button>
                    <a href="{{ path('logout') }}">
                        <button class="btn btn-primary">
                            Se déconnecter
                        </button>
                    </a>
                    {# End Options #}
            </div>
        </div>
    </div>
    {# Edit Password #}
    <form class="edit_password flex_vertical centered_flex secondary_block" method="post" id="form_edit_password">
        <div class="edit-password">
            <div class="form-floating">
                <input type="password" name="oldPassword" class="form-control" id="floatingPassword" placeholder="Password">
                <label for="floatingPassword">Ancien mot de passe</label>
            </div>

            <div class="form-floating">
                <input type="password" name="newPassword" class="form-control" id="floatingPassword" placeholder="Password">
                <label for="floatingPassword">Nouveau mot de passe</label>
                <ul class="list_require">
                    <li>Au moins 5 caractères</li>
                    <li>Au moins 1 caractère spécial</li>
                </ul>
            </div>

            <div class="form-floating">
                <input type="password" name="confirmPassword" class="form-control" id="floatingPassword" placeholder="Password">
                <label for="floatingPassword">Confirmation du nouveau mot de passe</label>
            </div>

            <button type="submit" class="btn btn-primary" onclick="return verifyInputEditPassword()">Valider</button>
        </div>
    </form>
    {# End Edit Password #}
{% endblock %}
