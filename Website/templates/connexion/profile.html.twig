{% extends 'base.html.twig' %}

{% block title %}
    Connexion
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/style/connexion/connexion.css">
    <link rel="stylesheet" href="/style/connexion/profile.css">

    {# Bootstrap CSS Import #}
    <link href="/style/bootstrap.min.css" rel="stylesheet"/>
    {# Icons #}
    <link rel='stylesheet' href='https://use.fontawesome.com/releases/v5.0.12/css/all.css'>
    {# End Bootstrap CSS Import #}

    {# Google Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
    {# End Google Fonts #}
{% endblock %}

{% block javascripts %}
    <script src="/script/connexion/profile.js"></script>

    {# Bootstrap JS Import #}
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
    {# End Bootstrap JS Import #}
{% endblock %}

{% block body %}

    <div class="flex_vertical centered_flex principal_block">
    <div class="top">
        <h1 class="top-text">Profil</h1>
        <a href="{{ path('home') }}">
            <img class="back-arrow" src="\img\icons\back_w.png" alt="back arrow">
        </a>
    </div>

        <img src="/img/connexion/user.png" alt="" id="img_profile">

        <h1 class="text_block">
            Bienvenue {{ user.login }}
        </h1>

        {% if edit is same as("wrong_password") %}
            <h2 class="message_information message_incorrect">
                Votre mot de passe est incorrect 
            </h2>
        {% elseif edit %}
            <h2 class="message_information message_correct">
                Modification effectuée avec succès 
            </h2>
        {% endif %}

        {# Client Informations #}
        <div>
            <table class="table_information">
                <tr>
                    <td>Solde :</td>
                    <td>{{ user.balance }} €</td>
                </tr>
                <tr>
                    <td>Compteur de fidelité :</td>
                    <td>{{ user.fidelityPoint }}</td>
                </tr>
                <tr>
                    <td>Statut :</td>
                    <td>{{ user.clientType.name }}</td>
                </tr>
            </table>
        {# End Client Informations #}

        {# Options #}
            <div class="flex_horizontal">
                <button class="btn btn-secondary" onclick="openCloseEditForm()">
                    Modifier son mot de passe
                </button>
                <a href="{{ path('logout') }}">
                <button class="btn btn-primary">
                    Se déconnecter
                    {# <a href="{{ path('logout') }}"></a> #}
                </button>
                </a> 
            </div>
        {# End Options #}
        </div>
    </div>
    {# Edit Password #}
    <form class="edit_password flex_vertical centered_flex secondary_block" method="post" id="form_edit_password">
        <div class="input_text flex_vertical">
                <label for="">Ancien mot de passe</label>
                <input type="password" name="oldPassword">
        </div>
        <div class="input_text flex_vertical">
                <label for="">Nouveau mot de passe :
                    <ul class="list_require">
                            <li>Au moins 5 caractères</li>
                            <li>Au moins 1 caractère spécial</li>
                    </ul>
                </label>
                <input type="password" name="newPassword">
        </div>
        <div class="input_text flex_vertical">
            <label for="">Nouveau mot de passe (confirmation) :</label>
            <input type="password" name="confirmPassword">
        </div>
        <button type="submit" class="btn" onclick="return verifyInputEditPassword()">Valider</button>
    </form>
    {# End Edit Password #}

{% endblock %}
