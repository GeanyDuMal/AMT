{% extends 'base.html.twig' %}

{% block title %}
    Connexion
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/style/connexion/connexion.css">
    <link rel="stylesheet" href="/style/connexion/profile.css">
{% endblock %}

{% block javascripts %}
      <script src="/script/connexion/profile.js"></script>
{% endblock %}

{% block body %}

    <div class="flex_vertical centered_flex">
        <h1>Profil</h1>
        <img src="/img/connexion/user.png" alt="" id="img_profile">

        <h1 class="text_block">
            Bienvenue {{ user.login }} : {{ edit }}
        </h1>

        {% if edit is same as("wrong_password") %}
            <h2 class="message_information message_correct">
                Votre mot de passe est incorrect 
            </h2>
        {% elseif edit %}
            <h2 class="message_information message_correct">
                Modification effectué avec succès 
            </h2>
        {% endif %}

        <table class="table_information">
            <tr>
                <td>Ton solde :</td>
                <td>{{ user.balance }} €</td>
            </tr>
            <tr>
                <td>Compteur de fidelité :</td>
                <td>{{ user.fidelityPoint }}</td>
            </tr>
            <tr>
                <td>Ton type :</td>
                <td>{{ user.clientType.name }}</td>
            </tr>
        </table>
        <div class="text_bottom flex_vertical centered_flex">
            <div class="btn" onclick="return ">
                Modifier son mot de passe
            </div>
            <form class="edit_password" method="post" id="form_edit_password">
                <div class="input_text flex_vertical">
                        <label for="">Ancien mot de passe</label>
                        <input type="password" name="oldPassword">
                </div>
                <div class="input_text flex_vertical">
                        <label for="">Nouveau mot de passe :
                              <ul class="list_require">
                                    <li>Au moins 5 caractères</li>
                                    <li>Au moins 1 caractère spécial</li>
                              </ul>
                        </label>
                        <input type="password" name="newPassword">
                </div>
                <div class="input_text flex_vertical">
                    <label for="">Nouveau mot de passe (confirmation) :</label>
                    <input type="password" name="confirmPassword">
                </div>
                <button type="submit" class="btn" onclick="return verifyInputEditPassword()">Valider</button>
            </form>
            <div class="btn">
                <a href="{{ path('logout') }}">Se deconnecter</a>
            </div>
        </div>
    </div>
{% endblock %}
