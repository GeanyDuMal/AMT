{% extends 'base.html.twig' %}

{% block title %}
    Connexion
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/style/connexion.css">
{% endblock %}


{% block body %}

    <div class="flex_vertical centered_flex">
        <h1>Profil</h1>
        <img src="/img/connexion/user.png" alt="" id="img_profile">

        <div class="text_block">
            Bienvenue {{ user.login }}
        </div>
        <table class="table_information">
            <tr>
                <td>Ton solde :</td>
                <td>{{ user.balance }}</td>
            </tr>
            <tr>
                <td>Compteur de fidelité :</td>
                <td>{{ user.fidelityPoint }}</td>
            </tr>
            <tr>
                <td>Ton type :</td>
                <td>{{ user.clientType.name }}</td>
            </tr>
        </table>
        <div class="text_bottom">
            <a href="{{ path('logout') }}">Se deconnecter</a>
        </div>
    </div>
{% endblock %}
