{% extends 'base.html.twig' %}

{% block title %}
      Inscription
{% endblock %}

{% block stylesheets %}
      <link rel="stylesheet" href="/style/connexion/signin.css">
{% endblock %}

{% block javascripts %}
      <script src="/script/connexion/signin.js"></script>
{% endblock %}

{% block body %}
      <div class="vertical_centered_menu">
            <h1>Inscription</h1>
            <img src="/img/connexion/user.png" alt="" srcset="" id="img_profile">
            
            {% if flush %}
                  <div>
                        <h3>TOUT S'EST BIEN PASSE</h3>
                  </div>
            {% endif %}

            <form action="" method="post" id="form_signin">
                  <div class="input_text">
                        <label for="">Nom :</label>
                        <input type="text" name="name">
                  </div> 
                  <div class="input_text">
                        <label for="">Prénom :</label>
                        <input type="text" name="firstName">
                  </div>
                  <div class="input_text">
                        <label for="">Login :
                              <ul class="list_require">
                                    <li>Au moins 5 caracteres</li>
                              </ul>
                        </label>
                        <input type="text" name="login">
                  </div>
                  <div class="input_text">
                        <label for="">Mot de passe :
                              <ul class="list_require">
                                    <li>Au moins 5 caractères</li>
                                    <li>Au moins 1 caractère spécial</li>
                              </ul>
                        </label>
                        <input type="password" name="password">
                  </div>
                  <div class="input_text">
                        <label for="">Mot de passe (confirmation) :</label>
                        <input type="password" name="confirmPassword">
                  </div>
                  <div>
                        <button type="submit" class="btn_valider" onclick="return verifyInput()">S'inscrire</button>   
                  </div>
            </form>
            <div class="text_bottom_signin">
                  Déja Client ? <a href="{{ path('login') }}">Connectez vous</a> 
            </div>
      </div>
{% endblock %}
