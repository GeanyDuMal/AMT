{% extends 'base.html.twig' %}

{% block title %}
    Inscription
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/style/connexion/connexion.css">

      {# Bootstrap CSS Import #}
      <link href="/style/bootstrap.min.css" rel="stylesheet"/>
      {# Icons #}
      <link rel='stylesheet' href='https://use.fontawesome.com/releases/v5.0.12/css/all.css'>
      {# End Bootstrap CSS Import #}

      {# Google Fonts #}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
      {# End Google Fonts #}
{% endblock %}


{% block javascripts %}
      <script src="/script/connexion/signin.js"></script>

      {# Bootstrap JS Import #}
      <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
      <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
      {# End Bootstrap JS Import #}
{% endblock %}

{% block body %}
      <div class="flex_vertical centered_flex">
            {# Top bar #}
            {% block navbar %}{% endblock %}
            <div class="top">
                  <h1 class="top-text">Inscription</h1>
                  <a href="javascript:history.go(-1)">
                  <img class="back-arrow" src="\img\icons\back_w.png" alt="back arrow"></a>
            </div>
            {# End Top bar #}
            <img src="/img/connexion/user.png" alt="" id="img_profile">

            {# Form Start #}
            <form action="" method="post" class="flex_vertical" id="form_signin">
                <div class="form-floating">
                    <input type="text" name="name" autofocus class="form-control" placeholder="Nom">
                    <label for="floating">Nom</label>
                </div>

                <div class="form-floating">
                    <input type="text" name="firstName" autofocus class="form-control" placeholder="Prenom">
                    <label for="floating">Prénom</label>
                </div>

                <div class="form-floating">
                      <input type="text" name="login" autofocus class="form-control" placeholder="Login">
                      <label for="floating">Login</label>
                      <ul class="list_require">
                            <li>Au moins 5 caractères</li>
                      </ul>
                </div>

                <div class="form-floating">
                      <input type="password" name="password" autofocus class="form-control" placeholder="Password">
                      <label for="floating">Mot De Passe</label>
                      <ul class="list_require">
                            <li>Au moins 5 caractères</li>
                            <li>Au moins 1 caractère spécial</li>
                      </ul>
                </div>

                <div class="form-floating">
                      <input type="password" name="confirmPassword" autofocus class="form-control" placeholder="Password">
                      <label for="floating">Confirmation Mot De Passe</label>
                </div>

                {% if loginExist %}
                    <div class="alert alert-dismissible alert-primary">
                          Le login que vous avez saisi existe déjà
                    </div>
                {% endif %}

                <div class="flex_vertical centered_flex">
                      <button type="submit" class="btn btn-primary" onclick="return verifyInputSignin()">S'inscrire</button>
                </div>
            </form>
            {# End Form #}

            <div class="text_bottom">
                  Déja Client ? <a href="{{ path('login') }}">Connectez vous</a> 
            </div>
      </div>
{% endblock %}
