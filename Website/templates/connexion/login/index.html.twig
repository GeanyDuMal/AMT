{% extends 'base.html.twig' %}

{% block title %}
    Connexion
{% endblock %}

{% block stylesheets %}
      <link rel="stylesheet" href="/style/connexion.css">
{% endblock %}


{% block body %}

    {% if error %}
        <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <div class="flex_vertical centered_flex">
        <h1>Connexion</h1>
        <img src="/img/connexion/user.png" alt="" id="img_profile">

        <form action="" class="flex_vertical" method="post" id="form_login">
            <div class="input_text flex_vertical">
                <label for="username">Login :</label>
                <input type="text" name="_username" value="{{ lastUsername }}" autofocus>
            </div>
            <div class="input_text flex_vertical">
                <label for="password">Mot de Passe :</label>
                <input type="password" name="_password">
            </div>
            <div class="flex_vertical centered_flex">
                <button type="submit" class="btn_valider">Se Connecter</button> {# a mettre plus tard onclick="return verifyInput()"#}
            </div>

            {# If you want to control the URL the user is redirected to on success
            <input type="hidden" name="_target_path" value="/account"/> #}
        </form>

        <div class="text_bottom">
            Pas encore Client ? <a href="{{ path('signin') }}">Inscrivez vous</a>
        </div>
    </div>
{% endblock %}
