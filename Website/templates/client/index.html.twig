{% extends 'home/index.html.twig' %}
{% block title %}
	Liste clients
{% endblock %}
{% block stylesheets %}
	{{ parent() }}
	<link rel='stylesheet' href="{{ asset('style/client/index.css') }}">
	<link rel='stylesheet' href="{{ asset('style/bootstrap.css') }}">
{% endblock %}
{% block javascripts %}
	{{ parent() }}
	<script type="text/javascript" src="{{ asset('script/client/index.js') }}"></script>
	<script type="text/javascript" src="{{ asset('script/client/ajax.js') }}"></script>
{% endblock %}

{% block body %}
	{% block navbar %}{{ parent() }}{% endblock %}
	{% block sidebar %}{{ parent() }}{% endblock %}
	<div class="content">
		<div class="content-header">
			<h1>Liste des clients</h1>
		</div>
		<br>
		{% if message is defined %}
			<div class="alert alert-dismissible alert-success">
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				<strong>{{ message }}!</strong>
			</div>
		{% endif %}
		<div align="right">
			<a href="{{ path('new_client') }}" class="btn btn-success">Ajouter</a>
		</div>
		<br>
		<table id="client_table" class="table table-striped">
			<thead bgcolor="#6cd8dc">
			<tr class="table-primary">
				<th width="10%">ID</th>
				<th width="15%">Nom</th>
				<th width="15%">Prénom</th>
				<th width="15%">Login</th>
				<th width="15%">Type du client</th>
				<th scope="col" width="5%">Modifier</th>
				<th scope="col" width="5%">Supprimer</th>
			</tr>
			</thead>
			<tbody>
			{% for client in clients %}
				<tr id="data">
					<td>{{ client.id }}</td>
					<td>{{ client.name }}</td>
					<td>{{ client.firstname }}</td>
					<td>{{ client.login }}</td>
					<td>{{ client.clientType.name }}</td>
					<td>
						<a href="{{url('edit_client',{id:client.id})}}" class="btn btn-warning" name="{{client.id}}">Modifier</a>
					</td>
					<td>
						<a id="toDelete" class="btn btn-danger" onclick="deleteClient();" data-id={{client.id}} >Supprimer</a>
					</td>
				</tr>
			{% endfor %}
			</tbody>
		</table>
	</div>
	{% block footer %}{{ parent() }}{% endblock %}
{% endblock %}
