{% extends 'home/index.html.twig' %}
{% block title %}
    Nouveau Client
{% endblock %}
{%  block javascripts %}
    {{ parent() }}
    <script type="text/javascript" src="{{ asset('script/client/addEditScripts.js') }}"></script>
{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel='stylesheet' href="{{ asset('style/bootstrap.css') }}">
    <link rel='stylesheet' href="{{ asset('style/client/index.css') }}">
{% endblock %}
{% block body %}
    {% block navbar %}{{ parent() }}{% endblock %}
    {% block sidebar %}{{ parent() }}{% endblock %}
    <div>
        <ul>
            {% if errors is defined and errors!="" %}
                {% for i in 0..errors.count()-1 %}
                    <li>{{ errors[i].message }}</li>
                {% endfor %}
            {% endif %}
        </ul>
    </div>
    {% set clientExists=client is defined %}
    <div class="container mt-5">

        <form action="" method="post" class="row g-3" id='form_Client'>
            {% if error is defined and error!="" %}
                <div class="alert alert-dismissible alert-danger">
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    {{ error }}.
                </div>
            {% endif %}
            <h1>Modification</h1>
            <div class="form-floating col-md-6">
                <input type="text" name="name"  class="form-control" id="floatingInput" placeholder="Nom" value={% if clientExists %}{{ client.name}} {% endif  %}>
                <label for="floatingInput">Nom</label>
            </div>
            <div class="form-floating col-md-6">
                <input type="text" name="fname"  class="form-control" id="floatingInput" placeholder="Prénom" value={% if clientExists %}{{ client.firstName}} {% endif  %}>
                <label for="floatingInput">Prénom</label>
            </div>
            <br>
            <div class="form-floating mb-3">
                <input type="text" name="login" class="form-control" id="floatingInput" name="login" placeholder="Login" value={% if clientExists %}{{ client.login}} {% endif  %}>
                <label for="floatingInput">Login</label>
            </div>
            <br>

            <div class="form-group col-md-6">
                <label>Balance</label>
                <div class="input-group mb-3">
                    <span class="input-group-text">€</span>
                    <input  type="text" name="balance" class="form-control" aria-label="Amount (to the nearest euro)" value={% if clientExists %}{{ client.balance}} {% endif  %}>
                    <span class="input-group-text">.00</span>
                </div>
            </div>
            <div class="form-group col-md-6">
                <label>Type</label>
                <select class="form-select" name="clientType" id="clientType" data-target="assosRoles"
                        data-source="path">
                    {% if clientExists %}
                    <option {% if client.roles[0]=="ROLE_USER" %} selected {% endif %} >
                        Etudiant
                    </option>
                    <option {% if client.roles[0]!="ROLE_USER" %} selected {% endif %} id="member">
                        Membre
                    </option>
                    {% endif %}
                </select>
            </div>
            <div class="form-group col-md-12" id="roles">
                <label>Role</label>
                <select id="assosRoles" class="form-control linked-select" name="types" id="clientType">
                    {% if clientExists %}
                        {% set typeName=client.clientType.name %}
                    {% endif %}
                    {% for type in types %}
                        <option {% if type.name==typeName %} selected {% endif %} >
                            {{type.name}}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <br>
            <input type="submit" class="btn btn-primary" value="Enregistrer" onclick="return verifier()" style="margin-bottom: 25px;">
        </form>
    </div>
    {% block footer %}{{ parent() }}{% endblock %}
{% endblock %}
