{% extends 'base.html.twig' %}

{% block title %}
    Nouveau Client
{% endblock %}

{%  block javascripts %}
    <script type="text/javascript" src="{{ asset('script/client/addEditScripts.js') }}"></script>
    <script type="text/javascript" src="{{ asset('script/generic/formGenericFunction.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/bootstrap.css') }}">
    <link rel='stylesheet' href="{{ asset('style/client/index.css') }}">
{% endblock %}

{% block body %}
    <div>
        <ul>
            {% if validationErrors is defined and validationErrors!="" %}
                {% for i in 0..validationErrors.count()-1 %}
                    <li>{{ validationErrors[i].message }}</li>
                {% endfor %}
            {% endif %}
        </ul>
    </div>
    {% set clientExists=client is defined %}
    {% set memberExists=member is not null %}
    <div class="container mt-5">

        <form action="" method="post" class="row g-3" id='form_Client' onsubmit="disableButton()">
            {% if errorLoginExist is defined and errorLoginExist!="" %}
                <div class="alert alert-dismissible alert-danger">
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    {{ errorLoginExist }}.
                </div>
            {% endif %}
            <h1>Modification</h1>
            <div class="form-floating col-md-6">
                <input type="text" name="name"  class="form-control" id="floatingInput" placeholder="Nom" value={% if clientExists %}{{ client.name}} {% endif  %}>
                <label for="floatingInput">Nom</label>
            </div>
            <div class="form-floating col-md-6">
                <input type="text" name="firstName"  class="form-control" id="floatingInput" placeholder="Prénom" value={% if clientExists %}{{ client.firstName}} {% endif  %}>
                <label for="floatingInput">Prénom</label>
            </div>
            <br>
            <div class="form-floating mb-3">
                <input type="text" name="login" class="form-control" id="floatingInput" name="login" placeholder="Login" value={% if clientExists %}{{ client.login}} {% endif  %}>
                <label for="floatingInput">Login</label>
            </div>
            <br>

            <div class="form-group col-md-6">
                <label>Solde</label>
                <div class="input-group mb-3">
                    <span class="input-group-text">€</span>
                    <input type="text" name="balance" class="form-control" aria-label="Amount (to the nearest euro)" value={% if clientExists %}{{ client.balance}} {% else %}0{% endif  %}>
                </div>
            </div>
            <div class="form-group col-md-6">
                <label>Point Fidélité</label>
                <div class="input-group mb-3">
                    <input type="text" name="fidelityPoint" class="form-control" value={% if clientExists %}{{ client.fidelityPoint}} {% else %}0{% endif  %}>
                </div>
            </div>

            <div class="form-group col-md-12">
                <label>Type</label>
                <select class="form-select" name="clientType" id="clientType" data-target="assosRoles"
                        data-source="path">
                    {% if clientExists %}
                    <option {% if client.clientType == "Etudiant" %} selected {% endif %}>
                        Etudiant
                    </option>
                    <option {% if client.clientType == "Association" %} selected {% endif %} id="member">
                        Association
                    </option>
                    {% endif %}
                </select>
            </div>
            <div class="form-group col-md-12" id="roles">
                <label>Role</label>
                <select name="assosRoles" id="assosRoles" class="form-control linked-select"  id="clientType">
                    {% if memberExists %}
                        {% set memberRoleName = member.role %}
                    {% else %}
                        {% set memberRoleName = null %}
                    {% endif %}
                    {% for assosRole in assosRoles %}
                        <option {% if assosRole == memberRoleName %} selected {% endif %} >
                            {{assosRole}}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <br>
            <button type="submit" class="btn btn-primary disableable" onclick="return verifyEdit()" style="margin-bottom: 25px;">
                Enregistrer
            </button>
        </form>
    </div>
{% endblock %}
