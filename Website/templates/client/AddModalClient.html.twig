{% extends 'base.html.twig' %}

{% block title %}
    Nouveau Client
{% endblock %}

{%  block javascripts %}
    <script type="text/javascript" src="/script/client/addEditScripts.js"></script>
    <script type="text/javascript" src="/script/generic/formGenericFunction.js"></script>
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/bootstrap.css') }}">
    <link rel='stylesheet' href="{{ asset('style/client/index.css') }}">
{% endblock %}

{% block body %}
    <div>
        <ul>
            {% if validationErrors is defined and validationErrors!="" %}
                {% for i in 0..validationErrors.count()-1 %}
                    <li>
                        {{ validationErrors[i].message }}
                    </li>
                {% endfor %}
            {% endif %}
        </ul>
    </div>


    <div class="container mt-5 ">
        <form action="" method="post" class="row g-2 " id='form_Client' onsubmit="disableButton()">
            {% if errorLoginExist is defined and errorLoginExist!="" %}
                <div class="alert alert-dismissible alert-danger">
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    {{ errorLoginExist }}.
                </div>
            {% endif %}
            <h1>Nouveau Client</h1>
            <div class="form-floating col-md-6">
                <input type="text" name="name" class="form-control" id="floatingInput" placeholder="Nom">
                <label for="floatingInput">Nom</label>
            </div>
            <div class="form-floating col-md-6">
                <input type="text" name="firstName" class="form-control" id="floatingInput" placeholder="Prénom">
                <label for="floatingInput">Prénom</label>
            </div>
            <br>
            <div class="form-floating mb-3">
                <input type="text" name="login" class="form-control" id="floatingInput" placeholder="Login">
                <label for="floatingInput">Login</label>
            </div>
            <br>
            <div class="form-floating ">
                <input type="password" name="password" class="form-control" id="floatingPassword" placeholder="Mot de passe">
                <label for="floatingPassword">Mot de passe</label>
            </div>
            <div class="col-auto">
                <span id="passwordHelpInline" class="form-text">
                    <ul>
                        <li>Au moins 5 caractères</li>
                        <li>Au moins 1 spéciales</li>
                    </ul>
                </span>
            </div>
            <br>
            <div class="form-floating">
                <input type="password" name="confirmPassword" class="form-control" id="floatingPassword"  placeholder="Confirmation Mot de passe">
                <label for="floatingPassword">Confirmation Mot de passe</label>
            </div>
            <br>


            <div class="form-group col-md-6">
                <label>Solde</label>
                <div class="input-group mb-3">
                    <span class="input-group-text">€</span>
                    <input value="0" type="text" name="balance" class="form-control" aria-label="Amount (to the nearest euro)">
                </div>
            </div>
            <div class="form-group col-md-6">
                <label>Type</label>
                <select class="form-select" name="clientType" id="clientType" data-target="assosRoles" data-source="path" value="0">
                    {% for clientType in clientTypes %}
                        <option >
                            {{ clientType }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group col-md-12" id="roles">
                <label>Role</label>
                <select name="assosRoles" id="assosRoles" class="form-control linked-select">
                    {% for assosRole in assosRoles %}
                        <option>
                            {{ assosRole }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <br>
            <button type="submit" class="btn btn-primary disableable" onclick="return verifyAdd()">
                Créer
            </button>
        </form>
    </div>
{% endblock %}
