{% extends 'base.html.twig' %}

{% block title %}
	Liste clients
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel='stylesheet' href="https://cdn.datatables.net/1.11.3/css/jquery.dataTables.min.css">
	<link rel='stylesheet' href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.dataTables.min.css">
	<link rel='stylesheet' href="{{ asset('style/client/index.css') }}">
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script type="text/javascript" src="{{ asset('script/client/index.js') }}"></script>
	<script type="text/javascript" src="{{ asset('script/client/ajaxMenuClient.js') }}"></script>
	<script type="text/javascript" src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script type="text/javascript" src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
	<script type="text/javascript" src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>

{% endblock %}

{% block body %}
	<div class="content">
		<div class="content-header">
			<h1>Liste des clients</h1>
		</div>
		{% if message %}
			<div class="alert alert-dismissible alert-success">
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				<strong>{{ message }}!</strong>
			</div>
		{% endif %}
		<div align="right">
			<a href="{{ path('new_client') }}" class="btn btn-success">Ajouter</a>
		</div>
		<br>
		{% if clients|length>0 %}
		<table id="client_table" class="table table-striped">
			<thead bgcolor="#6cd8dc">
			<tr class="table-primary">
				<th width="10%">ID</th>
				<th width="15%">Nom</th>
				<th width="15%">Prénom</th>
				<th width="15%">Login</th>
				<th width="15%">Type du client</th>
				<th scope="col" width="5%">Modifier</th>
				<th scope="col" width="5%">Supprimer</th>
			</tr>
			</thead>
			<tbody>
			{% for client in clients %}
				{% if app.user.login!=client.login %}
				<tr id="data">
					<td>{{ client.id }}</td>
					<td>{{ client.name }}</td>
					<td>{{ client.firstname }}</td>
					<td>{{ client.login }}</td>
					<td>{{ client.clientType }}</td>
					<td>
						<a href="{{url('edit_client',{id:client.id})}}" class="btn btn-warning bg-warning" name="{{client.id}}">Modifier</a>
					</td>
					<td>
						<a id="toDelete" class="btn btn-primary bg-danger" data-id={{client.id}} >Supprimer</a>
					</td>
				</tr>
				{% endif %}
			{% endfor %}
			</tbody>
		</table>
			{% else %}
				<div class="alert alert-info alert-dismissible fade show">
					<strong>Info!</strong> il n y a pas encore des clients.
					<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				</div>
		{% endif %}
	</div>
{% endblock %}
