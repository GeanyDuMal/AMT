{% extends 'base.html.twig' %}
{%  block javascripts %}
    {{ parent() }}
    <script type="text/javascript" src="{{ asset('script/blog/addEditVerificationsBlog.js') }}"></script>
{% endblock %}
{% block body %}
    <div>
        <ul>
            {% if validationErrors is defined and validationErrors!="" %}
                {% for i in 0..validationErrors.count()-1 %}
                    <li>{{ validationErrors[i].message }}</li>
                {% endfor %}
            {% endif %}
        </ul>
    </div>
    <form id="blog_form" action="" method="post">
        <input type="text" name="postTitle" placeholder="Titre" value="{{ post.title }}"> <br>
        <textarea name="postDescription" placeholder="Description">{{ post.description }}</textarea> <br>
        <input type="text" name="imageLink" placeholder="image" value="{{ post.imageLink }}"> <br>
        <select name="postType">
            {% for postType in postTypes %}
                <option {% if postType.name==post.postType.name %} selected {% endif %} > {{ postType.name }} </option>
            {% endfor %}
        </select> <br>
        <input type="submit" onclick="return verifyPost()">
    </form>
{% endblock %}