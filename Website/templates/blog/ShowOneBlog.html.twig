{% extends 'base.html.twig' %}

{% block title %}
    Blog : {{ blog.title }}
{% endblock %}

{% block stylesheets %}
    <link rel='stylesheet' href="{{ asset('style/bootstrap.css') }}">
    <link rel='stylesheet' href="{{ asset('style/client/index.css') }}">
    <style>
        .center {
            display: block;
            margin-left: auto;
            margin-right: auto;
            width: 50%;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-5 ">
        <form id="blog_form" class="row g-2 " method="post" >
            <h1>{{ blog.title }}</h1>
            <div class="col-md-12">
               <img style="max-width:50%;" class="img-responsive center"  src={{ blog.imageLink }}>
            </div>
            <div class="col-md-12">
            <h3>Contenu :</h3>
                <p>
                    {{ blog.description }}
                </p>
            </div>
        </form>
    </div>
{% endblock %}