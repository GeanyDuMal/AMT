{% extends 'base.html.twig' %}
{# {% extends 'home/AddModalBlog.html.twig' %} #}

{% block stylesheets %}
    {# Style Base Import #}
    <link href="/style/base/css/base.css" rel="stylesheet"/>
    {# End Style Base Import #}

    <link href="/style/blog/css/blog.css" rel="stylesheet"/>
    
    {# Bootstrap CSS Import #}
    {# <link href="https://bootswatch.com/_vendor/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet"/> #}
    <link href="/style/bootstrap.css" rel="stylesheet"/>
    {# Icons #}
    <link rel='stylesheet' href='https://use.fontawesome.com/releases/v5.0.12/css/all.css'>
    {# End Bootstrap CSS Import #}

    {# Google Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
    {# End Google Fonts #}
    <style>
        .card img {
            height: 280px;
        }
    </style>
{% endblock %}

{% block javascripts %}
    <script src="/script/base/base.js"></script>
    {# Bootstrap JS Import #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
    {# End Bootstrap JS Import #}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
{% endblock %}

{% block title %}Blog{% endblock %}

{% block body %}
    {% if message %}
        <div class="alert alert-dismissible alert-success fade show">
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            <strong>{{ message }}!</strong>
        </div>
    {% endif %}
<div class="container">
    <div class="text-center my-5">
        <h1 class="page__title">Posts & Events</h1>
        <hr />
    </div>
    {% if is_granted("ROLE_ASSOC") %}
    <div align="right">
        <a href="{{ path('add_blog') }}" class="btn btn-outline-primary rounded-0 ">Ajouter</a>
    </div>
        <br>
    {% endif %}

    <div class="row">
    {% for blog in blogs  %}
            <div class="col-lg-4 col-md-6 col-sm-12">
                <div class="card mb-5 shadow-sm">
                    <img src={{ blog.imageLink }} class="img-fluid" />
                    <div class="card-body">
                        <div class="card-title">
                            <h2>{{ blog.title }}</h2>
                        </div>
                        <div class="card-text">
                            <p>
                                {{ blog.description|slice(0, 30) }}...
                            </p>
                        </div>
                        <a href="{{url('selected_blog',{id:blog.id})}}" class="btn btn-outline-primary rounded-0 float-end">Lire plus</a>
                        {% if is_granted("ROLE_ASSOC") %}
                            <a href="{{url('edit_blog',{id:blog.id})}}" class="btn btn-outline-primary rounded-0 float-end">Modifier</a>
                        {% endif %}
                    </div>
                </div>
            </div>
    {% endfor %}
    </div>
</div>

{% endblock %}
